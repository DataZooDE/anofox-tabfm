# name: test/sql/tabfm_context_cache.test
# description: anofox_tabfm_context_cache serves EXACT pairs only. test/fixtures/tabicl ships the
#              first-generation pair (#38/#40, split.py): its prepare graph emits no `context_logits`,
#              so the context rows would be scored by a query pass that never sees their own labels,
#              and their fitted values would move. Since the cache became default-on
#              (docs/CONTEXT_CACHE_PLAN.md), such a pair is ignored: the combined graph serves every
#              call, with the setting on or off, and nothing is cached. The exact (kv) pair and the
#              cache itself are covered by tabfm_context_cache_kv.test.
# group: [anofox_tabfm]

require anofox_tabfm

require notwindows

statement ok
LOAD anofox_tabfm

statement ok
CALL tabfm_register_model(
  id := 'tabicl-fixture', base_dir := 'test/fixtures/tabicl',
  classification_graph := 'graph_tabicl_classification.onnx',
  regression_graph := 'graph_tabicl_regression.onnx',
  classification_weights := 'model_classification.safetensors',
  regression_weights := 'model_regression.safetensors',
  tensor_map := 'tensor_map_tabicl_classification.json',
  license := 'bsd-3-clause', commercial := true,
  weights_repo := 'local:test/fixtures/tabicl', weights_revision := 'fixture-v1',
  preprocessing_profile := 'tabicl_v2_raw',
  max_rows := 4096, max_features := 64, max_classes := 3)

query T
SELECT current_setting('anofox_tabfm_context_cache')
----
true

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,'c0'),(1.5,0.2,0.3,'c1'),(2.5,-1.0,0.5,'c2'),
  (0.2,0.8,0.7,'c0'),(1.1,0.4,0.2,'c1'),(3.0,-0.5,0.9,'c2'),
  (0.9,1.2,0.6,'c0'),(2.1,0.1,0.4,'c1'),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,label);

statement ok
SET anofox_tabfm_context_cache = false

statement ok
CREATE TABLE combined AS
SELECT f1, yhat, yhat_score, is_training
FROM tabfm_classify('t', 'label', model := 'tabicl-fixture');

statement ok
SET anofox_tabfm_context_cache = true

statement ok
CREATE TABLE with_setting AS
SELECT f1, yhat, yhat_score, is_training
FROM tabfm_classify('t', 'label', model := 'tabicl-fixture');

# Bit-identical, context rows included: the old pair's query pass over the context rows moved their
# scores by more than 1e-6 on this fixture, so this fails if it ever engages again.
query I
SELECT count(*) FROM combined c JOIN with_setting s USING (f1)
WHERE c.yhat <> s.yhat OR c.yhat_score <> s.yhat_score OR c.is_training <> s.is_training
----
0

query IIII
SELECT context_entries, context_hits, context_misses, context_bytes
FROM tabfm_models() WHERE model = 'tabicl-fixture' AND task = 'classification' AND loaded
----
0	0	0	0

# The fixture ships no pair at all for regression: the combined graph, and no error.
statement ok
CREATE TABLE r AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,1.2),(1.5,0.2,0.3,2.4),(2.5,-1.0,0.5,3.1),
  (0.2,0.8,0.7,0.9),(1.1,0.4,0.2,1.8),(3.0,-0.5,0.9,3.6),
  (0.9,1.2,0.6,1.1),(2.1,0.1,0.4,2.7),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,target);

query II
SELECT count(*), count(*) FILTER (WHERE yhat IS NULL)
FROM tabfm_regress('r', 'target', model := 'tabicl-fixture')
----
10	0

query I
SELECT context_entries FROM tabfm_models() WHERE model = 'tabicl-fixture' AND task = 'regression' AND loaded
----
0
