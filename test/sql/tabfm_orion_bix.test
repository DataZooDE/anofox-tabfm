# name: test/sql/tabfm_orion_bix.test
# description: Orion-BiX v1.1 (Lexsi Labs, MIT) onboarded as a real model. Like
#              TabPFN and TabICL its ONNX graph is (x, y)-only, so the engine's
#              y-as-train-prefix inference (no train_size input -> y is the
#              training prefix) drives it with no model-specific code. Uses the
#              committed random-init fixture (offline, zero Lexsi weight bytes).
#              Orion-BiX is the FIRST built-in with a single capability:
#              upstream ships a classifier only, so `regress` must fail with the
#              actionable unsupported-task error rather than silently running.
#              Real-weight accuracy is exercised out-of-band
#              (tools/export_orion_bix/convert_weights.py verifies the committed
#              tensor map covers all 277 checkpoint tensors).
# group: [anofox_tabfm]

require anofox_tabfm

require notwindows

statement ok
LOAD anofox_tabfm

# --- the built-in catalog entry ------------------------------------------------

query TTT
SELECT model, family, capabilities FROM tabfm_list_models() WHERE model = 'orion-bix'
----
orion-bix	icl-transformer	classify

# MIT weights: commercially usable, no license gate (unlike tabfm-v1 / tabpfn).
query TT
SELECT license, commercial FROM tabfm_list_models() WHERE model = 'orion-bix'
----
mit	true

# --- the fixture model (real forward pass, offline) ----------------------------

statement ok
CALL tabfm_register_model(
  id := 'orion-bix-fixture', base_dir := 'test/fixtures/orion_bix',
  classification_graph := 'graph_orion_bix_classification.onnx',
  classification_weights := 'model_classification.safetensors',
  tensor_map := 'tensor_map_orion_bix_classification.json',
  license := 'mit', commercial := true,
  weights_repo := 'local:test/fixtures/orion_bix', weights_revision := 'fixture-v1',
  preprocessing_profile := 'orion_bix_v1_minimal',
  max_rows := 4096, max_features := 64, max_classes := 3)

query TTT
SELECT model, family, capabilities FROM tabfm_list_models() WHERE model = 'orion-bix-fixture'
----
orion-bix-fixture	icl-transformer	classify

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,'c0'),(1.5,0.2,0.3,'c1'),(2.5,-1.0,0.5,'c2'),
  (0.2,0.8,0.7,'c0'),(1.1,0.4,0.2,'c1'),(3.0,-0.5,0.9,'c2'),
  (0.9,1.2,0.6,'c0'),(2.1,0.1,0.4,'c1'),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,label);

# a real forward pass through the (x, y)-only Orion-BiX graph via the y-prefix path
query II
SELECT count(*), count(*) FILTER (WHERE yhat NOT IN ('c0','c1','c2'))
FROM tabfm_classify('t', 'label', model := 'orion-bix-fixture')
----
10	0

query I
SELECT count(*) FROM tabfm_classify('t', 'label', model := 'orion-bix-fixture') WHERE yhat IS NULL
----
0

# --- error path: no regression head upstream -----------------------------------

statement ok
CREATE TABLE r AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,1.2),(1.5,0.2,0.3,2.4),(2.5,-1.0,0.5,3.1),
  (0.2,0.8,0.7,0.9),(1.1,0.4,0.2,1.8),(3.0,-0.5,0.9,3.6),
  (0.9,1.2,0.6,1.1),(2.1,0.1,0.4,2.7),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,target);

statement error
SELECT * FROM tabfm_regress('r', 'target', model := 'orion-bix-fixture')
----
does not support task

# the built-in entry refuses regression the same way (and before any download)
statement error
SELECT * FROM tabfm_regress('r', 'target', model := 'orion-bix')
----
does not support task
