# name: test/sql/tabfm_tabdpt13.test
# description: TabDPT v1.3 (Layer 6 AI, Apache-2.0) as a NEW catalog entry `tabdpt-v1-3` beside
#              `tabdpt` (v1.2, unchanged). TabArena: 1545 Elo for the v1.3 default against 1457 for
#              v1.2. Same repo (Layer6/TabDPT), new file tabdpt1_3.safetensors.
#
#              Not a drop-in for the v1.2 graphs: v1.3 replaces the per-layer y-encoder MLP
#              (y_encoders.*, Linear(1,256) -> GELU -> Linear(256,128)) with TWO per-layer encoders
#              chosen by task — cls_y_encoders.* (an Embedding(16, 128) over the class id) and
#              reg_y_encoders.* (Linear(1,128) -> GELU -> Linear(128,128)). 647 -> 679 tensors; every
#              other tensor keeps its name and shape, and the head (16 class logits + 2048 regression
#              bins) is unchanged. So it gets its own graphs (re-exported through tools/export_tabdpt)
#              and its own cache path inside the shared repo slug.
# group: [anofox_tabfm]

require anofox_tabfm

require notwindows

statement ok
LOAD anofox_tabfm

# --- the built-in catalog entry ------------------------------------------------

query TTTT
SELECT model, family, license, commercial FROM tabfm_list_models() WHERE model IN ('tabdpt', 'tabdpt-v1-3') ORDER BY model
----
tabdpt	icl-transformer	apache-2.0	true
tabdpt-v1-3	icl-transformer	apache-2.0	true

query TIII
SELECT capabilities, max_rows, max_features, max_classes FROM tabfm_list_models() WHERE model = 'tabdpt-v1-3'
----
classify, regress	100000	128	16

# --- the fixture model (offline forward passes) --------------------------------

statement ok
CALL tabfm_register_model(
  id := 'tabdpt13-fixture', base_dir := 'test/fixtures/tabdpt13',
  classification_graph := 'graph_tabdpt13_classification.onnx',
  regression_graph := 'graph_tabdpt13_regression.onnx',
  classification_weights := 'model.safetensors',
  regression_weights := 'model.safetensors',
  classification_tensor_map := 'tensor_map_tabdpt13_classification.json',
  regression_tensor_map := 'tensor_map_tabdpt13_regression.json',
  license := 'apache-2.0', commercial := true,
  preprocessing_profile := 'tabdpt_v1_raw',
  max_rows := 4096, max_features := 16, max_classes := 4)

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,'c0'),(1.5,0.2,0.3,'c1'),(2.5,-1.0,0.5,'c2'),
  (0.2,0.8,0.7,'c0'),(1.1,0.4,0.2,'c1'),(3.0,-0.5,0.9,'c2'),
  (0.9,1.2,0.6,'c0'),(2.1,0.1,0.4,'c1'),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,label);

query II
SELECT count(*), count(*) FILTER (WHERE yhat NOT IN ('c0','c1','c2'))
FROM tabfm_classify('t', 'label', model := 'tabdpt13-fixture')
----
10	0

statement ok
CREATE TABLE r AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,1.2),(1.5,0.2,0.3,2.4),(2.5,-1.0,0.5,3.1),
  (0.2,0.8,0.7,0.9),(1.1,0.4,0.2,1.8),(3.0,-0.5,0.9,3.6),
  (0.9,1.2,0.6,1.1),(2.1,0.1,0.4,2.7),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,target);

query II
SELECT count(*), count(*) FILTER (WHERE yhat IS NULL OR NOT isfinite(yhat))
FROM tabfm_regress('r', 'target', model := 'tabdpt13-fixture')
----
10	0
