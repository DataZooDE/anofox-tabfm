# name: test/sql/tabfm_gpu_graphs.test
# description: Model-provided GPU graphs (docs/GPU_HARDENING_PLAN.md P3):
#              tabfm_register_model accepts ext_graph / migraphx_graph per
#              task, and a declared-but-missing GPU graph fails loudly at
#              resolution — a broken declaration is an error, not a silent
#              "GPU quietly unavailable". The GPU dispatch itself needs
#              hardware and lives in tools/gpu_test/scenarios/; this file
#              covers the CPU-checkable surface.
# group: [anofox_tabfm]

require anofox_tabfm

statement ok
LOAD anofox_tabfm

# --- registration accepts the new per-task GPU graph arguments ---------------
# The fixture graph doubles as the ext graph here: it IS external-data format,
# which is exactly what the field means. (MIGraphX cannot run it — measured,
# spike U1 — but registration is about declaration, not compatibility; the
# plugin reports incompatibility clearly at create time on real hardware.)
statement ok
CALL tabfm_register_model(
  id := 'gpu-fixture', base_dir := 'test/fixtures',
  classification_graph := 'graph_fixture.onnx',
  classification_ext_graph := 'graph_fixture.onnx',
  classification_migraphx_graph := 'graph_fixture.onnx',
  classification_weights := 'model.safetensors',
  classification_tensor_map := 'tensor_map_fixture.json',
  license := 'fixture-mit', preprocessing_profile := 'tabfm_v1_minimal')

# CPU predict still works with GPU graphs declared — they are additive.
statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,'c0'),(1.5,0.2,0.3,'c1'),(2.5,-1.0,0.5,'c2'),
  (0.2,0.8,0.7,'c0'),(1.1,0.4,0.2,'c1'),(3.0,-0.5,0.9,'c2'),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,label);

statement ok
SET anofox_tabfm_device = 'cpu'

query I
SELECT count(*) FROM tabfm_classify('t','label', model := 'gpu-fixture')
----
8

# The registered model is visible in tabfm_models(), including which backend
# served it. tabfm_models() was blind to registered models whose weights live
# outside the download cache — which meant the device column could not prove a
# GPU ran for exactly the model class that model-provided GPU graphs enable.
query III
SELECT model, loaded, device FROM tabfm_models() WHERE model = 'gpu-fixture'
----
gpu-fixture	true	cpu

# The row must survive a missing download cache: registered models keep their
# weights in source_dir, so an absent cache dir (a fresh machine, or CI) must
# not blank tabfm_models(). This is the exact condition CI runs under.
statement ok
SET anofox_tabfm_cache_dir = '__TEST_DIR__/no_such_cache'

query III
SELECT model, loaded, device FROM tabfm_models() WHERE model = 'gpu-fixture'
----
gpu-fixture	true	cpu

statement ok
RESET anofox_tabfm_cache_dir

# --- a declared GPU graph that does not exist fails at resolution ------------
# Deliberately on the CPU path too: a model declaring a file that is not there
# is a broken declaration, same as a missing plain graph — failing the first
# predict names the path instead of leaving the GPU silently unreachable.
statement ok
CALL tabfm_register_model(
  id := 'gpu-broken', base_dir := 'test/fixtures',
  classification_graph := 'graph_fixture.onnx',
  classification_ext_graph := 'no_such_graph_ext.onnx',
  classification_weights := 'model.safetensors',
  classification_tensor_map := 'tensor_map_fixture.json',
  license := 'fixture-mit', preprocessing_profile := 'tabfm_v1_minimal')

statement error
SELECT count(*) FROM tabfm_classify('t','label', model := 'gpu-broken')
----
<REGEX>:.*declares ext_graph 'no_such_graph_ext.onnx'.*does not exist.*

statement ok
CALL tabfm_unregister_model('gpu-fixture')

statement ok
CALL tabfm_unregister_model('gpu-broken')
