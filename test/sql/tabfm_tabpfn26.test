# name: test/sql/tabfm_tabpfn26.test
# description: TabPFN-2.6 (Prior Labs), #2 single model on the TabArena v0.1.4
#              board. A 2.5-LINE architecture — same emsize/nhead/thinking-row
#              layout and the same pre-generated column-embedding table — so it
#              exports through the 2.5 patch surface with NO new export patches.
#              What changed is layernorm_type="rmsnorm" and a deeper per-layer
#              parameterisation: 322 clf / 324 reg mapped initializers against
#              2.5's 250 / 192, which is why it gets its own graphs rather than
#              sharing 2.5's the way tabpfn-v2-5-real does.
#
#              Uses the committed random-init fixture (offline, zero Prior Labs
#              weight bytes). Real-weight behaviour is in tabfm_real_models.test.
# group: [anofox_tabfm]

require anofox_tabfm

require notwindows

statement ok
LOAD anofox_tabfm

# --- the built-in catalog entry ------------------------------------------------

query TTT
SELECT model, family, capabilities FROM tabfm_list_models() WHERE model = 'tabpfn-v2-6'
----
tabpfn-v2-6	icl-transformer	classify, regress

# non-commercial + gated, like the rest of the post-v2 Prior Labs line
query TTT
SELECT model, license, commercial FROM tabfm_list_models()
WHERE model IN ('tabpfn-v2-5', 'tabpfn-v2-6') ORDER BY model
----
tabpfn-v2-5	tabpfn-2.5-license-v1.1	false
tabpfn-v2-6	tabpfn-2.6-license-v1.0	false

# 2.6 genuinely widens the supported regime (2.5: 10000 / 500).
query III
SELECT max_rows, max_features, max_classes FROM tabfm_list_models() WHERE model = 'tabpfn-v2-6'
----
50000	2000	10

# --- the fixture model (real forward pass, offline) ----------------------------

statement ok
CALL tabfm_register_model(
  id := 'tabpfn-v2-6-fixture', base_dir := 'test/fixtures/tabpfn26',
  classification_graph := 'graph_tabpfn26_classification.onnx',
  regression_graph := 'graph_tabpfn26_regression.onnx',
  classification_weights := 'model.safetensors',
  regression_weights := 'model_regression.safetensors',
  classification_tensor_map := 'tensor_map_tabpfn26_classification.json',
  regression_tensor_map := 'tensor_map_tabpfn26_regression.json',
  license := 'tabpfn-2.6-license-v1.0', commercial := false,
  preprocessing_profile := 'tabpfn_v2_6_raw',
  max_rows := 4096, max_features := 64, max_classes := 4)

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,'c0'),(1.5,0.2,0.3,'c1'),(2.5,-1.0,0.5,'c2'),
  (0.2,0.8,0.7,'c0'),(1.1,0.4,0.2,'c1'),(3.0,-0.5,0.9,'c2'),
  (0.9,1.2,0.6,'c0'),(2.1,0.1,0.4,'c1'),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,label);

# a real forward pass through the 2.6 rmsnorm graph
query II
SELECT count(*), count(*) FILTER (WHERE yhat NOT IN ('c0','c1','c2'))
FROM tabfm_classify('t', 'label', model := 'tabpfn-v2-6-fixture')
----
10	0

query I
SELECT count(*) FROM tabfm_classify('t', 'label', model := 'tabpfn-v2-6-fixture') WHERE yhat IS NULL
----
0

statement ok
CREATE TABLE r AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,1.2),(1.5,0.2,0.3,2.4),(2.5,-1.0,0.5,3.1),
  (0.2,0.8,0.7,0.9),(1.1,0.4,0.2,1.8),(3.0,-0.5,0.9,3.6),
  (0.9,1.2,0.6,1.1),(2.1,0.1,0.4,2.7),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,target);

query II
SELECT count(*), count(*) FILTER (WHERE yhat IS NULL)
FROM tabfm_regress('r', 'target', model := 'tabpfn-v2-6-fixture')
----
10	0
