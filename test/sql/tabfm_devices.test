# name: test/sql/tabfm_devices.test
# description: tabfm_devices() — device discovery output shape (SQL-API §3, HLD §9)
# group: [anofox_tabfm]

require anofox_tabfm

statement ok
LOAD anofox_tabfm

# At least one device is always discovered (the cpu row exists in every flavor)
query I
SELECT count(*) >= 1 FROM tabfm_devices();
----
true

# Full name and alias return the same relation
query I
SELECT count(*) = (SELECT count(*) FROM anofox_tabfm_devices()) FROM tabfm_devices();
----
true

# The cpu row: fixed id/ep, always usable, no VRAM semantics, non-empty name
query IIIIIII
SELECT device_id, ep, usable, vram_total IS NULL, vram_free IS NULL, name <> '', arch = ''
FROM tabfm_devices()
WHERE device_id = 'cpu';
----
cpu	CPUExecutionProvider	true	true	true	true	true

# Column names and types exactly as specified (SQL-API §3)
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM tabfm_devices());
----
device_id	VARCHAR
ep	VARCHAR
name	VARCHAR
arch	VARCHAR
vram_total	BIGINT
vram_free	BIGINT
driver	VARCHAR
usable	BOOLEAN

# Works via CALL too (management-call convention, SQL-API §3)
statement ok
CALL tabfm_devices();

# --- Apple MLX (docs/MLX_PLAN.md) ---------------------------------------------
# The mlx row exists only on Apple Silicon, so this asserts the INVARIANTS that
# hold everywhere rather than a row count that would fail on Linux CI.

# There is at most one mlx row, and if present it is the SoC's single logical
# device: ordinal 0, unified memory (no VRAM semantics), non-empty name.
query I
SELECT count(*) <= 1 FROM tabfm_devices() WHERE device_id LIKE 'mlx%';
----
true

query I
SELECT coalesce(bool_and(
           device_id = 'mlx:0' AND ep = 'MlxBackend'
           AND vram_total IS NULL AND vram_free IS NULL
           AND name <> ''), true)
FROM tabfm_devices() WHERE device_id LIKE 'mlx%';
----
true

# An mlx row implies an Apple SoC: discovery must never invent one on hardware
# that cannot run Metal.
query I
SELECT coalesce(bool_and(lower(name) LIKE '%apple%'), true)
FROM tabfm_devices() WHERE device_id LIKE 'mlx%';
----
true

# The cpu row is never displaced by it.
query I
SELECT count(*) = 1 FROM tabfm_devices() WHERE device_id = 'cpu' AND usable;
----
true
