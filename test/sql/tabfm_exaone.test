# name: test/sql/tabfm_exaone.test
# description: EXAONE Tabular v1 (LG AI Research) onboarded as a real model: a Cross-Axis Summary
#              Transformer whose WEIGHTS are under the EXAONE AI Model License Agreement 1.2 - NC
#              (non-commercial), so the built-in is commercial:false and gated by
#              anofox_tabfm_accept_hf_license like the TabPFN-2.5 / Causilo entries. Like TabICL its ONNX
#              graph is (x, y)-only, so the engine's y-as-train-prefix inference drives it with no
#              model-specific code; the model standardises its own features (profile exaone_v1_raw).
#
#              Uses the committed random-init fixture: offline, zero LG AI Research weight bytes. It PINS A
#              VALUE FOR EVERY ROW, context and query; the expected values come from
#              test/fixtures/exaone/golden_<task>.json, computed by PyTorch from inputs that are exact in
#              binary floating point (tools/export_exaone/src/export_exaone/fixture.py). Real-weight quality
#              is exercised out-of-band (test/sql/tabfm_real_models.test).
# group: [anofox_tabfm]

require anofox_tabfm

require notwindows

statement ok
LOAD anofox_tabfm

# --- the built-in catalog entry ------------------------------------------------

query TTT
SELECT model, family, capabilities FROM tabfm_list_models() WHERE model = 'exaone-tabular'
----
exaone-tabular	icl-transformer	classify, regress

# Non-commercial weights: the licence id and the flag say so.
query TT
SELECT license, commercial FROM tabfm_list_models() WHERE model = 'exaone-tabular'
----
exaone-nc-1.2	false

# --- the fixture model (real forward pass, offline) ----------------------------

# One weights file PER TASK: LG release the classifier and the regressor as separate checkpoints.
statement ok
CALL tabfm_register_model(
  id := 'exaone-fixture', base_dir := 'test/fixtures/exaone',
  classification_graph := 'graph_exaone_classification.onnx',
  regression_graph := 'graph_exaone_regression.onnx',
  classification_weights := 'model_classification.safetensors',
  regression_weights := 'model_regression.safetensors',
  classification_tensor_map := 'tensor_map_exaone_classification.json',
  regression_tensor_map := 'tensor_map_exaone_regression.json',
  license := 'bsd-3-clause-lg', commercial := true,
  weights_repo := 'local:test/fixtures/exaone', weights_revision := 'fixture-v1',
  preprocessing_profile := 'exaone_v1_raw',
  max_rows := 4096, max_features := 64, max_classes := 3)

query TTT
SELECT model, family, capabilities FROM tabfm_list_models() WHERE model = 'exaone-fixture'
----
exaone-fixture	icl-transformer	classify, regress

# The table is built from the same formulas the fixture builder used (fixture.sql_inputs):
#   x[i][j] = ((i*7 + j*3 + (i*j) % 5) % 11) * 0.25 - 1.0 + ((i*13 + j*5 + (i*j) % 3) % 7) * 0.0625
#   label   = 'c' || ((i*5 + i//3) % 3)   for the first 12 rows (context); NULL after (query)
statement ok
CREATE TABLE t AS SELECT i AS id,
  ((i*7 + 0*3 + (i*0) % 5) % 11) * 0.25 - 1.0 + ((i*13 + 0*5 + (i*0) % 3) % 7) * 0.0625 AS f1,
  ((i*7 + 1*3 + (i*1) % 5) % 11) * 0.25 - 1.0 + ((i*13 + 1*5 + (i*1) % 3) % 7) * 0.0625 AS f2,
  ((i*7 + 2*3 + (i*2) % 5) % 11) * 0.25 - 1.0 + ((i*13 + 2*5 + (i*2) % 3) % 7) * 0.0625 AS f3,
  ((i*7 + 3*3 + (i*3) % 5) % 11) * 0.25 - 1.0 + ((i*13 + 3*5 + (i*3) % 3) % 7) * 0.0625 AS f4,
  ((i*7 + 4*3 + (i*4) % 5) % 11) * 0.25 - 1.0 + ((i*13 + 4*5 + (i*4) % 3) % 7) * 0.0625 AS f5,
  CASE WHEN i < 12 THEN 'c' || ((i*5 + i // 3) % 3) END AS label
FROM range(20) r(i);

query III
SELECT count(*), count(*) FILTER (WHERE is_training), count(*) FILTER (WHERE yhat IS NULL)
FROM tabfm_classify('t', 'label', features := ['f1','f2','f3','f4','f5'], model := 'exaone-fixture')
----
20	12	0

# the exact predicted label for ALL 20 rows, context and query alike, matched on the five feature values
# (exact binary fractions, unique per row; the first query asserts that, so a duplicate cannot hide)
statement ok
CREATE TABLE exp_cls AS SELECT t.f1, t.f2, t.f3, t.f4, t.f5, e.expected FROM t JOIN
  (VALUES (0,'c1'),(1,'c1'),(2,'c1'),(3,'c1'),(4,'c1'),(5,'c1'),(6,'c1'),(7,'c1'),(8,'c1'),(9,'c1'),(10,'c1')
             ,(11,'c0'),(12,'c1'),(13,'c1'),(14,'c1'),(15,'c1'),(16,'c1'),(17,'c1'),(18,'c1'),(19,'c1'))
  e(id, expected) USING (id);

query II
SELECT count(*), count(DISTINCT (f1, f2, f3, f4, f5)) FROM exp_cls
----
20	20

query II
SELECT count(*), count(*) FILTER (WHERE a.yhat <> e.expected)
FROM tabfm_classify('t', 'label', features := ['f1','f2','f3','f4','f5'], model := 'exaone-fixture') a
JOIN exp_cls e ON a.f1 = e.f1 AND a.f2 = e.f2 AND a.f3 = e.f3 AND a.f4 = e.f4 AND a.f5 = e.f5
----
20	0

# the context rows are real in-context values, not a pad: the golden has 2 distinct labels among them
query I
SELECT count(DISTINCT yhat)
FROM tabfm_classify('t', 'label', features := ['f1','f2','f3','f4','f5'], model := 'exaone-fixture')
WHERE is_training
----
2

# regression: RAW-space point estimate for ALL 20 rows (the wrapper standardises the targets, reduces the
# quantile head to its mean and inverts the scaler in-graph)
statement ok
CREATE TABLE r AS SELECT i AS id,
  ((i*7 + 0*3 + (i*0) % 5) % 11) * 0.25 - 1.0 + ((i*13 + 0*5 + (i*0) % 3) % 7) * 0.0625 AS f1,
  ((i*7 + 1*3 + (i*1) % 5) % 11) * 0.25 - 1.0 + ((i*13 + 1*5 + (i*1) % 3) % 7) * 0.0625 AS f2,
  ((i*7 + 2*3 + (i*2) % 5) % 11) * 0.25 - 1.0 + ((i*13 + 2*5 + (i*2) % 3) % 7) * 0.0625 AS f3,
  ((i*7 + 3*3 + (i*3) % 5) % 11) * 0.25 - 1.0 + ((i*13 + 3*5 + (i*3) % 3) % 7) * 0.0625 AS f4,
  ((i*7 + 4*3 + (i*4) % 5) % 11) * 0.25 - 1.0 + ((i*13 + 4*5 + (i*4) % 3) % 7) * 0.0625 AS f5,
  CASE WHEN i < 12 THEN ((i*37) % 17) * 0.25 - 2.0 END AS target
FROM range(20) r(i);

query III
SELECT count(*), count(*) FILTER (WHERE is_training), count(*) FILTER (WHERE yhat IS NULL)
FROM tabfm_regress('r', 'target', features := ['f1','f2','f3','f4','f5'], model := 'exaone-fixture')
----
20	12	0

statement ok
CREATE TABLE exp_reg AS SELECT r.f1, r.f2, r.f3, r.f4, r.f5, e.expected FROM r JOIN
  (VALUES (0,1.201545),(1,1.146384),(2,1.037803),(3,1.069141),(4,1.276363),(5,1.105376),(6,0.88076)
             ,(7,1.035789),(8,0.918517),(9,0.482426),(10,1.301118),(11,1.334981),(12,1.692936),(13,0.80321)
             ,(14,0.678456),(15,0.997896),(16,0.999435),(17,0.853802),(18,1.475512),(19,0.778419))
  e(id, expected) USING (id);

query II
SELECT count(*), count(*) FILTER (WHERE abs(a.yhat - e.expected) > 1e-3)
FROM tabfm_regress('r', 'target', features := ['f1','f2','f3','f4','f5'], model := 'exaone-fixture') a
JOIN exp_reg e ON a.f1 = e.f1 AND a.f2 = e.f2 AND a.f3 = e.f3 AND a.f4 = e.f4 AND a.f5 = e.f5
----
20	0

# the fitted (context) values vary: a zero-padded context would decode to a single number
query I
SELECT count(DISTINCT round(yhat, 4))
FROM tabfm_regress('r', 'target', features := ['f1','f2','f3','f4','f5'], model := 'exaone-fixture')
WHERE is_training
----
12

# a single feature column (one token per column, so H = 1 is a legal table)
query II
SELECT count(*), count(*) FILTER (WHERE yhat IS NULL OR isnan(yhat))
FROM tabfm_regress('r', 'target', features := ['f1'], model := 'exaone-fixture')
----
20	0

# A missing feature cell is mean-imputed by the engine before the graph, so it is answered.
# (EXAONE's own non-finite code channel therefore never sees a NaN; docs/REAL_MODELS.md says so.)
statement ok
CREATE TABLE tn AS SELECT id, CASE WHEN id = 14 THEN NULL ELSE f1 END AS f1, f2, f3, f4, f5, label FROM t;

query II
SELECT count(*), count(*) FILTER (WHERE yhat IS NULL)
FROM tabfm_classify('tn', 'label', features := ['f1','f2','f3','f4','f5'], model := 'exaone-fixture')
----
20	0

# error path: more classes than the model's head is a property of the model, and the message names the
# model, the count and where to look
statement ok
CREATE TABLE t4 AS SELECT id, f1, f2, f3, f4, f5,
  CASE WHEN id < 12 THEN 'k' || (id % 4) END AS label FROM t;

statement error
SELECT count(*) FROM tabfm_classify('t4', 'label', features := ['f1','f2','f3','f4','f5'], model := 'exaone-fixture')
----
supports at most 3 classes
