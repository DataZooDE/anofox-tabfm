# name: test/sql/tabfm_tabpfn25.test
# description: TabPFN-2.5 (Prior Labs) onboarded alongside TabPFN v2. Same
#              (x, y)-only graph contract as v2, so the engine's y-as-train-prefix
#              path drives it with no model-specific code — the 2.5 work is an
#              exporter change (tools/export_tabpfn --config real25), not an
#              engine change. Uses the committed random-init fixture (offline,
#              zero Prior Labs weight bytes).
#
#              The 2.5 line RELICENSED vs v2: tabpfn-2.5-license-v1.1 forbids
#              commercial/production use, so the built-in entry is
#              commercial:false + gated, unlike the commercial:true 'tabpfn-v2'.
#              That distinction is asserted below — it is the whole point of
#              shipping them as separate catalog entries.
# group: [anofox_tabfm]

require anofox_tabfm

require notwindows

statement ok
LOAD anofox_tabfm

# --- the built-in catalog entry ------------------------------------------------

query TTT
SELECT model, family, capabilities FROM tabfm_list_models() WHERE model = 'tabpfn-v2-5'
----
tabpfn-v2-5	icl-transformer	classify, regress

# non-commercial + gated, in contrast to tabpfn-v2 on the row below
query TTT
SELECT model, license, commercial FROM tabfm_list_models()
WHERE model IN ('tabpfn-v2', 'tabpfn-v2-5') ORDER BY model
----
tabpfn-v2	apache-2.0	true
tabpfn-v2-5	tabpfn-2.5-license-v1.1	false

# --- the fixture model (real forward pass, offline) ----------------------------

statement ok
CALL tabfm_register_model(
  id := 'tabpfn-v2-5-fixture', base_dir := 'test/fixtures/tabpfn25',
  classification_graph := 'graph_tabpfn25_classification.onnx',
  regression_graph := 'graph_tabpfn25_regression.onnx',
  classification_weights := 'model.safetensors',
  regression_weights := 'model_regression.safetensors',
  classification_tensor_map := 'tensor_map_tabpfn25_classification.json',
  regression_tensor_map := 'tensor_map_tabpfn25_regression.json',
  license := 'tabpfn-2.5-license-v1.1', commercial := false,
  preprocessing_profile := 'tabpfn_v2_5_raw',
  max_rows := 4096, max_features := 64, max_classes := 4)

query TTT
SELECT model, family, capabilities FROM tabfm_list_models() WHERE model = 'tabpfn-v2-5-fixture'
----
tabpfn-v2-5-fixture	icl-transformer	classify, regress

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,'c0'),(1.5,0.2,0.3,'c1'),(2.5,-1.0,0.5,'c2'),
  (0.2,0.8,0.7,'c0'),(1.1,0.4,0.2,'c1'),(3.0,-0.5,0.9,'c2'),
  (0.9,1.2,0.6,'c0'),(2.1,0.1,0.4,'c1'),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,label);

# a real forward pass through the 2.5 graph (24-layer arch shape, thinking rows)
query II
SELECT count(*), count(*) FILTER (WHERE yhat NOT IN ('c0','c1','c2'))
FROM tabfm_classify('t', 'label', model := 'tabpfn-v2-5-fixture')
----
10	0

query I
SELECT count(*) FROM tabfm_classify('t', 'label', model := 'tabpfn-v2-5-fixture') WHERE yhat IS NULL
----
0

# regression runs too — the 2.5 regressor graph emits the same [1,T,1] RAW-space
# point estimate as v2 (bar-distribution mean + de-standardization, in-graph)
statement ok
CREATE TABLE r AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,1.2),(1.5,0.2,0.3,2.4),(2.5,-1.0,0.5,3.1),
  (0.2,0.8,0.7,0.9),(1.1,0.4,0.2,1.8),(3.0,-0.5,0.9,3.6),
  (0.9,1.2,0.6,1.1),(2.1,0.1,0.4,2.7),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,target);

query II
SELECT count(*), count(*) FILTER (WHERE yhat IS NULL)
FROM tabfm_regress('r', 'target', model := 'tabpfn-v2-5-fixture')
----
10	0
