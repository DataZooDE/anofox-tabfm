# name: test/sql/tabfm_v1_1.test
# description: Google TabFM 1.1.0 (`tabfm-v1-1`, HF google/tabfm-1.1.0-pytorch), the second TabFM
#              release. Same architecture code as tabfm-v1, but its checkpoint differs in the two
#              ways that can break the engine: an EXPLICIT decoder_hidden (v1 ships null and falls
#              back to icl_dim*2) and BF16 safetensors (v1 is F32). Part 1 asserts the built-in
#              catalog entry and its licence gate; part 2 drives a committed random-init fixture
#              with exactly those two properties (decoder_hidden 24 where the fallback is 32, every
#              tensor BF16) and pins EVERY row, context and query, against the unmodified upstream
#              estimator (tools/make_fixture/src/make_fixture/fixture_v1_1.py; n_estimators=1).
#              Offline, zero Google weight bytes. Real-weight quality: tabfm_real_models.test.
# group: [anofox_tabfm]

require anofox_tabfm

require notwindows

statement ok
LOAD anofox_tabfm

# --- 1. the built-in catalog entry ---------------------------------------------------------------

query TTTTIII
SELECT model, family, capabilities, license, max_rows, max_features, max_classes
FROM tabfm_list_models() WHERE model = 'tabfm-v1-1'
----
tabfm-v1-1	icl-transformer	classify, regress	tabfm-non-commercial-v1.0	100000	500	10

# The same non-commercial TabFM licence as v1 (the LICENSE files are byte-identical), so the
# entry is commercial:false and gated by the licence acknowledgement.
query T
SELECT commercial FROM tabfm_list_models() WHERE model = 'tabfm-v1-1'
----
false

# v1 is untouched by the new entry
query TTT
SELECT model, capabilities, license FROM tabfm_list_models() WHERE model = 'tabfm-v1'
----
tabfm-v1	classify, regress	tabfm-non-commercial-v1.0

statement ok
SET anofox_tabfm_cache_dir = '__TEST_DIR__/tabfm_v1_1_cache'

statement error
CALL tabfm_download('classification', model := 'tabfm-v1-1')
----
licensed 'tabfm-non-commercial-v1.0' (non-commercial, no redistribution). Run: SET anofox_tabfm_accept_hf_license = true;

statement error
CALL tabfm_download('regression', model := 'tabfm-v1-1')
----
licensed 'tabfm-non-commercial-v1.0' (non-commercial, no redistribution). Run: SET anofox_tabfm_accept_hf_license = true;

# the gate fires before any I/O
query I
SELECT count(*) FROM glob('__TEST_DIR__/tabfm_v1_1_cache/*')
----
0

# --- 2. the BF16 / explicit-decoder fixture, every row pinned ------------------------------------

statement ok
CALL tabfm_register_model(
  id := 'tabfm-v1-1-fixture', base_dir := 'test/fixtures/tabfm_v1_1',
  classification_graph := 'graph_tabfm_v1_1_classification.onnx',
  regression_graph := 'graph_tabfm_v1_1_regression.onnx',
  classification_weights := 'model_classification.safetensors',
  regression_weights := 'model_regression.safetensors',
  classification_tensor_map := 'tensor_map_tabfm_v1_1_classification.json',
  regression_tensor_map := 'tensor_map_tabfm_v1_1_regression.json',
  license := 'apache-2.0', commercial := true,
  weights_repo := 'local:test/fixtures/tabfm_v1_1', weights_revision := 'fixture-v1',
  preprocessing_profile := 'tabfm-v1',
  max_rows := 4096, max_features := 64, max_classes := 3)

# The table repeats fixture_v1_1.sql_table() verbatim; every cell is exact in binary floating point:
#   x[i][j] = ((i*7 + j*3 + (i*j) % 5) % 11) * 0.25 - 1.0
#   label   = 'c' || ((i*5 + i//3) % 3)   for the first 12 rows (context); NULL after (query)
#   target  = ((i*37) % 17) * 0.25 - 2.0  for the first 12 rows
statement ok
CREATE TABLE t AS SELECT i AS id,
  ((i*7 + 0*3 + (i*0) % 5) % 11) * 0.25 - 1.0 AS f1,
  ((i*7 + 1*3 + (i*1) % 5) % 11) * 0.25 - 1.0 AS f2,
  ((i*7 + 2*3 + (i*2) % 5) % 11) * 0.25 - 1.0 AS f3,
  ((i*7 + 3*3 + (i*3) % 5) % 11) * 0.25 - 1.0 AS f4,
  ((i*7 + 4*3 + (i*4) % 5) % 11) * 0.25 - 1.0 AS f5,
  CASE WHEN i < 12 THEN 'c' || ((i*5 + i // 3) % 3) END AS label,
  CASE WHEN i < 12 THEN ((i*37) % 17) * 0.25 - 2.0 END AS target
FROM range(20) r(i);

statement ok
CREATE TABLE tc AS SELECT id, f1, f2, f3, f4, f5, label FROM t;

statement ok
CREATE TABLE tr AS SELECT id, f1, f2, f3, f4, f5, target FROM t;

# the result carries the feature columns, not `id`: rows are matched on their five (unique) values
query II
SELECT count(*), count(DISTINCT (f1, f2, f3, f4, f5)) FROM t
----
20	20

# expected: upstream TabFMClassifier (single member) label + top probability, softmax temperature 0.9
statement ok
CREATE TABLE exp_cls AS SELECT t.f1, t.f2, t.f3, t.f4, t.f5, e.expected, e.score FROM t JOIN
  (VALUES (0,'c0',0.575368),(1,'c1',0.895215),(2,'c1',0.799819),(3,'c1',0.904058),(4,'c2',0.808835),
          (5,'c1',0.644956),(6,'c1',0.529791),(7,'c1',0.946128),(8,'c1',0.922519),(9,'c2',0.991021),
          (10,'c1',0.755896),(11,'c1',0.902994),(12,'c0',0.946279),(13,'c2',0.927156),(14,'c2',0.844859),
          (15,'c2',0.924815),(16,'c2',0.700435),(17,'c2',0.830441),(18,'c0',0.772273),(19,'c0',0.892453))
  e(id, expected, score) USING (id);

query III
SELECT count(*), count(*) FILTER (WHERE a.yhat <> e.expected), count(*) FILTER (WHERE abs(a.yhat_score - e.score) > 1e-4)
FROM tabfm_classify('tc', 'label', features := ['f1','f2','f3','f4','f5'], model := 'tabfm-v1-1-fixture') a
JOIN exp_cls e ON a.f1 = e.f1 AND a.f2 = e.f2 AND a.f3 = e.f3 AND a.f4 = e.f4 AND a.f5 = e.f5
----
20	0	0

# context rows are a real in-context fit, not a pad: more than one label there
query I
SELECT count(DISTINCT yhat) > 1
FROM tabfm_classify('tc', 'label', features := ['f1','f2','f3','f4','f5'], model := 'tabfm-v1-1-fixture')
WHERE is_training
----
true

# expected: upstream TabFMRegressor (single member), raw target space
statement ok
CREATE TABLE exp_reg AS SELECT t.f1, t.f2, t.f3, t.f4, t.f5, e.expected FROM t JOIN
  (VALUES (0,12.464525),(1,4.829597),(2,15.400967),(3,12.621222),(4,11.555421),(5,10.711573),(6,12.269867),
          (7,10.839045),(8,14.607736),(9,10.44935),(10,13.924636),(11,11.581398),(12,-32.77879),(13,-18.948867),
          (14,-3.873186),(15,-30.323912),(16,-38.669916),(17,-37.434577),(18,-32.865774),(19,-4.892765))
  e(id, expected) USING (id);

query III
SELECT count(*), count(*) FILTER (WHERE is_training), count(*) FILTER (WHERE abs(a.yhat - e.expected) > 1e-3)
FROM tabfm_regress('tr', 'target', features := ['f1','f2','f3','f4','f5'], model := 'tabfm-v1-1-fixture') a
JOIN exp_reg e ON a.f1 = e.f1 AND a.f2 = e.f2 AND a.f3 = e.f3 AND a.f4 = e.f4 AND a.f5 = e.f5
----
20	12	0
