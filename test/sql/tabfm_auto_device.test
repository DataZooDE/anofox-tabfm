# name: test/sql/tabfm_auto_device.test
# description: 'auto' resolves per model, and never to a device that model
#              cannot be served on. Uses the committed weight-free fixture, so
#              it runs anywhere — including CI, which has no GPU and no weights.
# group: [anofox_tabfm]

require anofox_tabfm

statement ok
LOAD anofox_tabfm

statement ok
CALL tabfm_register_model(
  id := 'fixture', base_dir := 'test/fixtures',
  classification_graph := 'graph_fixture.onnx',
  classification_weights := 'model.safetensors',
  classification_tensor_map := 'tensor_map_fixture.json',
  license := 'fixture-mit', preprocessing_profile := 'tabfm_v1_minimal')

statement ok
SET anofox_tabfm_device = 'auto';

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
  (0.5,1.0,'a','x',0.1,'c0'),(1.5,0.2,'b','y',0.3,'c1'),(2.5,-1.0,'a','y',0.5,'c2'),
  (0.2,0.8,'b','x',0.7,'c0'),(1.1,0.4,'a','y',0.2,'c1'),(3.0,-0.5,'b','y',0.9,'c2'),
  (0.9,1.2,'a','x',0.6,'c0'),(2.1,0.1,'b','y',0.4,'c1'),
  (1.3,0.3,'a','y',0.35,NULL),(2.4,-0.2,'b','x',0.55,NULL))
  v(f1,f2,f3,f4,f5,label);

# Whatever device auto picks, a predict still returns one row per input row.
# This is the floor: auto must never choose something that does not work.
query I
SELECT count(*) FROM tabfm_classify('t', 'label', model := 'fixture');
----
10

# THE invariant. 'auto' may only ever name a device this model can actually be
# served on — which is what makes a per-model 'auto' safe where a session-wide
# one was not: there is no fallback event to report because no fallback
# happens. A row here means auto chose a device tabfm_backends() says cannot
# serve that model: the silent-wrong-device failure that the *_SERVED_BY
# assertions in tools/gpu_test exist to catch, caught in-process instead.
query I
SELECT count(*)
FROM tabfm_models() m
-- Join on TASK as well. Without it a loaded mitra/classification matched the
-- mitra/REGRESSION capability row too, whose weights were never downloaded --
-- so the invariant reported a violation that had not happened. Caught on CUDA,
-- where only the classification weights had been fetched; it passes locally
-- only because the fixture model has a single task.
JOIN tabfm_backends() b
  ON b.model = m.model AND b.task = m.task AND b.device = m.device
WHERE m.loaded AND b.supported IS NOT TRUE;
----
0

# The chosen device must be hardware this machine actually reported.
query I
SELECT count(*) FROM tabfm_models() m
WHERE m.loaded AND m.device NOT IN (SELECT device_id FROM tabfm_devices());
----
0

# An explicit request is NOT weakened by any of this: the asymmetry
# IsExplicitGpuRequest encodes is left intact, and test_tabfm_ort_engine.cpp
# asserts it directly (an absent device raises, naming tabfm_devices(), rather
# than quietly becoming CPU). Not repeated here, because the outcome depends on
# what hardware the runner has.

statement ok
SET anofox_tabfm_device = 'cpu';

# ...and the CPU lane still works after all of it.
query I
SELECT count(*) FROM tabfm_classify('t', 'label', model := 'fixture');
----
10
