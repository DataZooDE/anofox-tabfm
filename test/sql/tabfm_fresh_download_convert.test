----
is missing 248 of the 250 tensors model 'tabpfn-v2-5' needs

statement error
SELECT * FROM tabfm_regress('rctx', 'target', test := 'rqry', model := 'tabpfn-v2-5')
----
is missing 190 of the 192 tensors model 'tabpfn-v2-5' needs

