# ---------------------------------------------------------------------------
# Executable is not the same as right: TabDPT classification (v1.2 and v1.3) runs on mlx and disagrees with
# the CPU (63-66 of 100 labels; context rows scored near-uniform where the CPU is near-certain), and so does
# orion-msp (9 of 100). They are refused by name (MlxKnownWrong) until the misinterpreted op is found, and
# the refusal says why and names the way out.

statement ok
SET anofox_tabfm_device = 'mlx';

statement error
SELECT count(*) FROM tabfm_classify('gc', 'label', features := ['f1', 'f2', 'f3', 'f4', 'f5', 'f6', 'f7', 'f8'], model := 'tabdpt-v1-3')
----
<REGEX>:.*disagrees with the CPU.*anofox_tabfm_device='cpu'.*

statement error
SELECT count(*) FROM tabfm_classify('gc', 'label', features := ['f1', 'f2', 'f3', 'f4', 'f5', 'f6', 'f7', 'f8'], model := 'tabdpt')
----
<REGEX>:.*disagrees with the CPU.*anofox_tabfm_device='cpu'.*

statement error
SELECT count(*) FROM tabfm_classify('gc', 'label', features := ['f1', 'f2', 'f3', 'f4', 'f5', 'f6', 'f7', 'f8'], model := 'orion-msp')
----
<REGEX>:.*disagrees with the CPU.*anofox_tabfm_device='cpu'.*

# ...and the capability relation says so up front, per task.
query TTTT
SELECT model, task, supported, coalesce(reason LIKE '%disagrees with the CPU%', false) FROM tabfm_backends()
WHERE backend = 'mlx' AND model IN ('tabdpt', 'tabdpt-v1-3', 'orion-msp', 'kumo-tabular-small') ORDER BY model, task
----
kumo-tabular-small	classification	true	false
kumo-tabular-small	regression	true	false
orion-msp	classification	false	true
tabdpt	classification	false	true
tabdpt	regression	true	false
tabdpt-v1-3	classification	false	true
tabdpt-v1-3	regression	true	false

# Under 'auto' an Apple-silicon machine must not pick mlx for a graph mlx gets wrong: tabdpt classification
# is served, on the CPU, without a word.
statement ok
SET anofox_tabfm_device = 'auto';

statement ok
CALL tabfm_unload();

query I
SELECT count(*) FROM tabfm_classify('gc', 'label', features := ['f1', 'f2', 'f3', 'f4', 'f5', 'f6', 'f7', 'f8'], model := 'tabdpt')
----
100

query T
SELECT string_agg(DISTINCT device, ',') FROM tabfm_models() WHERE loaded AND model = 'tabdpt' AND task = 'classification'
----
cpu

