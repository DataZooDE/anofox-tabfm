# ===========================================================================
# The rest of the catalogue (sweep of 2026-11-01, Apple M3, 100 rows, against the CPU). Each block
# unloads first so the file stays inside 16 GB; tabfm-v1 (6.6 GB per task) holds one session at a time.

# ---------------------------------------------------------------------------
# limix-2m
# LimiX-2M had never been run on a Mac. It exposed two interpreter bugs, both fixed with a weight-free
# fixture in test/cpp/test_tabfm_mlx_plugin.cpp: integer Div was a true division (a Slice end of
# 2 * ((H + 1) / 2) came out H + 1 and the next Reshape failed, so neither task ran), and float64
# initializers/constants were reinterpreted as float32 (regression then ran but disagreed: max |diff|
# 1.74, corr 0.9938). Measured after the fixes: 0/100 labels, regression max |diff| 1.1e-5.

statement ok
CALL tabfm_unload();

statement ok
SET anofox_tabfm_device = 'cpu';

statement ok
CREATE TABLE limix_2m_cc AS SELECT rid, yhat FROM tabfm_classify('gc', 'label', features := ['f1', 'f2', 'f3', 'f4', 'f5', 'f6', 'f7', 'f8'], model := 'limix-2m') JOIN gc USING (f1, f2, f3, f4, f5, f6, f7, f8);

statement ok
CREATE TABLE limix_2m_cr AS SELECT rid, yhat FROM tabfm_regress('gr', 'target', features := ['f1', 'f2', 'f3', 'f4', 'f5', 'f6', 'f7', 'f8'], model := 'limix-2m') JOIN gr USING (f1, f2, f3, f4, f5, f6, f7, f8);

statement ok
SET anofox_tabfm_device = 'mlx';

statement ok
CREATE TABLE limix_2m_gc AS SELECT rid, yhat FROM tabfm_classify('gc', 'label', features := ['f1', 'f2', 'f3', 'f4', 'f5', 'f6', 'f7', 'f8'], model := 'limix-2m') JOIN gc USING (f1, f2, f3, f4, f5, f6, f7, f8);

statement ok
CREATE TABLE limix_2m_gr AS SELECT rid, yhat FROM tabfm_regress('gr', 'target', features := ['f1', 'f2', 'f3', 'f4', 'f5', 'f6', 'f7', 'f8'], model := 'limix-2m') JOIN gr USING (f1, f2, f3, f4, f5, f6, f7, f8);

query TT
SELECT task, bool_or(device = 'mlx:0') FROM tabfm_models() WHERE loaded AND model = 'limix-2m' GROUP BY task ORDER BY task
----
classification	true
regression	true

query I
SELECT count(*) FILTER (WHERE c.yhat <> g.yhat) FROM limix_2m_cc c JOIN limix_2m_gc g USING (rid)
----
0

query I
SELECT max(abs(c.yhat - g.yhat)) < 1e-2 AND corr(c.yhat, g.yhat) > 0.99999 FROM limix_2m_cr c JOIN limix_2m_gr g USING (rid)
----
true

