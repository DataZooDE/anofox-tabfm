# name: test/sql/tabfm_gpu_precompile.test
# description: tabfm_gpu_precompile honours both documented ways of choosing a model, and on a device
#              with no per-shape compile says so ('not needed', NULL bucket) instead of claiming a compile
# group: [anofox_tabfm]

require anofox_tabfm

statement ok
LOAD anofox_tabfm

statement ok
CALL tabfm_register_model(
  id := 'fixture', base_dir := 'test/fixtures',
  classification_graph := 'graph_fixture.onnx',
  classification_weights := 'model.safetensors',
  classification_tensor_map := 'tensor_map_fixture.json',
  license := 'fixture-mit', preprocessing_profile := 'tabfm_v1_minimal')

# A SECOND registered model, and it is what makes this file a test at all.
#
# ModelRegistry::Build sets implicit_default_ when exactly ONE model is
# SQL-registered, and Resolve falls back to it before throwing
# (src/tabfm_registry.cpp). With a single registration, empty resolution still
# lands on 'fixture' — so every assertion below passed with the fix reverted,
# which was verified by actually reverting it. Two registrations leave
# implicit_default_ empty, so the execute path can only reach the right model
# if the bind genuinely carried it.
statement ok
CALL tabfm_register_model(
  id := 'fixture-two', base_dir := 'test/fixtures',
  classification_graph := 'graph_fixture.onnx',
  classification_weights := 'model.safetensors',
  classification_tensor_map := 'tensor_map_fixture.json',
  license := 'fixture-mit', preprocessing_profile := 'tabfm_v1_minimal')

statement ok
SET anofox_tabfm_device = 'cpu';

# Regression: the bind validated the model and then threw the answer away, and
# the execute path re-resolved with an EMPTY model id against a context whose
# default_model was never set. Both documented ways of selecting a model were
# therefore discarded, and the failure was the generic "N models are registered
# and none is selected" — which names the two remedies that had just been
# ignored. Harmless while the registry held one model; broken for every install
# once the catalog grew.
query IIIII
SELECT task, rows, features, device, status FROM tabfm_gpu_precompile('classification', 64, 4, model := 'fixture');
----
classification	64	4	cpu	not needed

# The full row on a device with nothing to compile: the resolved device (not the
# setting), status 'not needed' rather than a claim that something compiled, the
# model the call resolved, and NULL buckets -- only ROCm pads to a bucket.
query IIIIIIIII
SELECT task, rows, features, device, status, model, bucket_rows, bucket_features, seconds >= 0
FROM tabfm_gpu_precompile('classification', 64, 4, model := 'fixture');
----
classification	64	4	cpu	not needed	fixture	NULL	NULL	true

# 'auto' on a host where it resolves to the CPU reports the device it resolved to.
statement ok
SET anofox_tabfm_device = 'auto';

query II
SELECT device IS NOT NULL AND device <> 'auto', model FROM tabfm_gpu_precompile('classification', 64, 4, model := 'fixture');
----
true	fixture

statement ok
SET anofox_tabfm_device = 'cpu';

# The CALL form still works.
statement ok
CALL tabfm_gpu_precompile('classification', 64, 4, model := 'fixture');

# ...and via the session default, the other remedy the error text advertises.
statement ok
SET anofox_tabfm_default_model = 'fixture';

query IIIIII
SELECT task, rows, features, device, status, model FROM tabfm_gpu_precompile('classification', 64, 4);
----
classification	64	4	cpu	not needed	fixture

# The one-argument overload resolves a model the same way.
query I
SELECT count(*) FROM tabfm_gpu_precompile('classification');
----
1

# With TWO models registered there is no implicit default, so an empty
# selection must now raise — and the error must still name both remedies.
statement ok
SET anofox_tabfm_default_model = '';

statement error
CALL tabfm_gpu_precompile('classification', 64, 4);
----
model :=

# The other half of the fix: PrecompileBind assembles its PredictContext by
# hand, so it silently missed the ep_path default and refused with "no backend
# plugin directory is configured. SET anofox_tabfm_ep_path" on machines where
# tabfm_accelerate() had already installed the plugin.
#
# Asserted through behaviour available on every runner: with ep_path unset,
# precompile must NOT fail for a missing plugin directory. On a CPU-only host
# it succeeds outright; the point is that the empty-ep_path refusal is gone.
statement ok
SET anofox_tabfm_ep_path = '';

query IIIII
SELECT task, rows, features, device, status FROM tabfm_gpu_precompile('classification', 64, 4, model := 'fixture');
----
classification	64	4	cpu	not needed

# ...and an explicit ep_path is still honoured rather than overridden by the
# default.
statement ok
SET anofox_tabfm_ep_path = '__TEST_DIR__/precompile_ep';

query IIIII
SELECT task, rows, features, device, status FROM tabfm_gpu_precompile('classification', 64, 4, model := 'fixture');
----
classification	64	4	cpu	not needed

statement ok
SET anofox_tabfm_ep_path = '';
