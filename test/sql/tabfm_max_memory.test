# name: test/sql/tabfm_max_memory.test
# description: anofox_tabfm_max_memory (issue #2) — a memory watchdog checked
#              right before each predict engine call. It compares this
#              process's CURRENT resident memory against the ceiling, not an
#              estimate of what the call about to run will cost, so an
#              arbitrarily small ceiling deterministically trips it (any live
#              process already has some resident memory) while '' (disabled,
#              the default) and a very large ceiling never do.
# group: [anofox_tabfm]

require anofox_tabfm

statement ok
LOAD anofox_tabfm

statement ok
CALL tabfm_register_model(
  id := 'fixture', base_dir := 'test/fixtures',
  classification_graph := 'graph_fixture.onnx',
  classification_weights := 'model.safetensors',
  classification_tensor_map := 'tensor_map_fixture.json',
  license := 'fixture-mit', preprocessing_profile := 'tabfm_v1_minimal')

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
  (0.5,1.0,'a','x',0.1,'c0'),(1.5,0.2,'b','y',0.3,'c1'),(2.5,-1.0,'a','y',0.5,'c2'),
  (0.2,0.8,'b','x',0.7,'c0'),(1.1,0.4,'a','y',0.2,'c1'),(3.0,-0.5,'b','y',0.9,'c2'),
  (0.9,1.2,'a','x',0.6,'c0'),(2.1,0.1,'b','y',0.4,'c1'),
  (1.3,0.3,'a','y',0.35,NULL),(2.4,-0.2,'b','x',0.55,NULL))
  v(f1,f2,f3,f4,f5,label);

# --- Disabled by default: the fixture forward pass runs unhindered ------------

query I
SELECT count(*) FROM tabfm_classify('t','label')
----
10

# --- A ceiling far above any live process's RSS never trips -------------------

statement ok
SET anofox_tabfm_max_memory = '1TB'

query I
SELECT count(*) FROM tabfm_classify('t','label')
----
10

# --- An arbitrarily tiny ceiling always trips: this process's own resident ----
# --- memory already exceeds 1 byte before the call can even start ------------

statement ok
SET anofox_tabfm_max_memory = '1B'

statement error
SELECT * FROM tabfm_classify('t','label')
----
<REGEX>:.*anofox_tabfm_max_memory.*

# the error names both remediations
statement error
SELECT * FROM tabfm_classify('t','label')
----
<REGEX>:.*(tabfm_unload|SET anofox_tabfm_max_memory).*

# --- Disabling the check again lifts the guard --------------------------------

statement ok
SET anofox_tabfm_max_memory = ''

query I
SELECT count(*) FROM tabfm_classify('t','label')
----
10

# --- The second half: what the call itself will cost --------------------------
#
# The check above is a watchdog on memory ALREADY held, so it cannot see a call
# that is small at entry and enormous at exit. The engine now measures what a
# forward pass of a given (model, device, T, H) actually added and refuses the
# NEXT call of that same shape when resident + observed would reach the ceiling.
#
# The positive case cannot be triggered deterministically from here: the fixture
# graph is tiny, so a forward of it moves resident memory by nothing measurable,
# no observation is recorded, and there is nothing for the guard to act on. That
# is the honest state of it -- the evidence that it fires is a real model on a
# real dataset (SemgHandMovementCh2, 450x500 context, 128 query rows, 32 GB
# container), not this fixture. What IS worth pinning here is that the new path
# introduces no false refusals and no behaviour change when it has nothing to go
# on, which is every call in this file.

statement ok
SET anofox_tabfm_max_memory = '1TB'

# Repeated identical calls: the first records a cost for this shape, the rest are
# checked against it. A ceiling of 1TB is unreachable, so all of them must pass.
query I
SELECT count(*) FROM tabfm_classify('t','label')
----
10

query I
SELECT count(*) FROM tabfm_classify('t','label')
----
10

query I
SELECT count(*) FROM tabfm_classify('t','label')
----
10

# A different shape shares nothing with the one already measured: the guard keys
# on (model, device, T, H) exactly, and never extrapolates between shapes.
statement ok
CREATE TABLE t2 AS SELECT * FROM (VALUES
  (0.5,1.0,'a','x',0.1,'c0'),(1.5,0.2,'b','y',0.3,'c1'),(2.5,-1.0,'a','y',0.5,'c2'),
  (0.2,0.8,'b','x',0.7,'c0'),(1.1,0.4,'a','y',0.2,'c1'),
  (1.3,0.3,'a','y',0.35,NULL))
  v(f1,f2,f3,f4,f5,label);

query I
SELECT count(*) FROM tabfm_classify('t2','label')
----
6

statement ok
SET anofox_tabfm_max_memory = ''
