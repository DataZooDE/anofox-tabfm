# name: test/sql/tabfm_max_memory.test
# description: anofox_tabfm_max_memory (issue #2) — a memory watchdog checked
#              right before each predict engine call. It compares this
#              process's CURRENT resident memory against the ceiling, not an
#              estimate of what the call about to run will cost, so an
#              arbitrarily small ceiling deterministically trips it (any live
#              process already has some resident memory) while '' (disabled,
#              the default) and a very large ceiling never do.
# group: [anofox_tabfm]

require anofox_tabfm

statement ok
LOAD anofox_tabfm

statement ok
CALL tabfm_register_model(
  id := 'fixture', base_dir := 'test/fixtures',
  classification_graph := 'graph_fixture.onnx',
  classification_weights := 'model.safetensors',
  classification_tensor_map := 'tensor_map_fixture.json',
  license := 'fixture-mit', preprocessing_profile := 'tabfm_v1_minimal')

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
  (0.5,1.0,'a','x',0.1,'c0'),(1.5,0.2,'b','y',0.3,'c1'),(2.5,-1.0,'a','y',0.5,'c2'),
  (0.2,0.8,'b','x',0.7,'c0'),(1.1,0.4,'a','y',0.2,'c1'),(3.0,-0.5,'b','y',0.9,'c2'),
  (0.9,1.2,'a','x',0.6,'c0'),(2.1,0.1,'b','y',0.4,'c1'),
  (1.3,0.3,'a','y',0.35,NULL),(2.4,-0.2,'b','x',0.55,NULL))
  v(f1,f2,f3,f4,f5,label);

# --- Disabled by default: the fixture forward pass runs unhindered ------------

query I
SELECT count(*) FROM tabfm_classify('t','label')
----
10

# --- A ceiling far above any live process's RSS never trips -------------------

statement ok
SET anofox_tabfm_max_memory = '1TB'

query I
SELECT count(*) FROM tabfm_classify('t','label')
----
10

# --- An arbitrarily tiny ceiling always trips: this process's own resident ----
# --- memory already exceeds 1 byte before the call can even start ------------

statement ok
SET anofox_tabfm_max_memory = '1B'

statement error
SELECT * FROM tabfm_classify('t','label')
----
<REGEX>:.*anofox_tabfm_max_memory.*

# the error names both remediations
statement error
SELECT * FROM tabfm_classify('t','label')
----
<REGEX>:.*(tabfm_unload|SET anofox_tabfm_max_memory).*

# --- Disabling the check again lifts the guard --------------------------------

statement ok
SET anofox_tabfm_max_memory = ''

query I
SELECT count(*) FROM tabfm_classify('t','label')
----
10
