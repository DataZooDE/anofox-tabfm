# name: test/sql/tabfm_causilo.test
# description: Causilo (Nums AI; Apache-2.0 code, non-commercial weights) onboarded as a real
#              model. Like TabICL its ONNX graph is (x, y)-only, so the engine's y-as-train-
#              prefix inference drives it with no model-specific code, and the graph
#              normalises its own features (profile causilo_v1_raw). Uses the committed
#              random-init fixture: offline, zero Nums AI weight bytes.
#
#              Unlike the TabICL test this one PINS A VALUE FOR EVERY ROW, context and query.
#              "The output is non-NULL" cannot tell a right answer from a wrong one, and
#              the context rows (`is_training`) are exactly where an earlier family of models
#              silently returned one constant. The expected values come from
#              test/fixtures/causilo/golden_<task>.json, computed by PyTorch from inputs that
#              are exact in binary floating point and so identical here; the fixture builder
#              asserts they are not near-ties. Real-weight accuracy is exercised out-of-band
#              (test/sql/tabfm_real_models.test, examples/causilo.json).
# group: [anofox_tabfm]

require anofox_tabfm

require notwindows

statement ok
LOAD anofox_tabfm

statement ok
CALL tabfm_register_model(
  id := 'causilo-fixture', base_dir := 'test/fixtures/causilo',
  classification_graph := 'graph_causilo_classification.onnx',
  regression_graph := 'graph_causilo_regression.onnx',
  classification_weights := 'model_classification.safetensors',
  regression_weights := 'model_regression.safetensors',
  classification_tensor_map := 'tensor_map_causilo_classification.json',
  regression_tensor_map := 'tensor_map_causilo_regression.json',
  license := 'apache-2.0', commercial := true,
  weights_repo := 'local:test/fixtures/causilo', weights_revision := 'fixture-v1',
  preprocessing_profile := 'causilo_v1_raw',
  max_rows := 4096, max_features := 64, max_classes := 3)

query TTT
SELECT model, family, capabilities FROM tabfm_list_models() WHERE model = 'causilo-fixture'
----
causilo-fixture	icl-transformer	classify, regress

# The table is built from the same formulas the fixture builder used (fixture.sql_inputs):
#   x[i][j] = ((i*7 + j*3 + (i*j) % 5) % 11) * 0.25 - 1.0      exact in float32
#   label   = 'c' || ((i*5 + i//3) % 3)   for the first 12 rows (context); NULL after (query)
statement ok
CREATE TABLE t AS SELECT i AS id,
  ((i*7 + 0*3 + (i*0) % 5) % 11) * 0.25 - 1.0 AS f1,
  ((i*7 + 1*3 + (i*1) % 5) % 11) * 0.25 - 1.0 AS f2,
  ((i*7 + 2*3 + (i*2) % 5) % 11) * 0.25 - 1.0 AS f3,
  ((i*7 + 3*3 + (i*3) % 5) % 11) * 0.25 - 1.0 AS f4,
  ((i*7 + 4*3 + (i*4) % 5) % 11) * 0.25 - 1.0 AS f5,
  CASE WHEN i < 12 THEN 'c' || ((i*5 + i // 3) % 3) END AS label
FROM range(20) r(i);

# every row is answered: 12 context rows flagged is_training, 8 query rows
query III
SELECT count(*), count(*) FILTER (WHERE is_training), count(*) FILTER (WHERE yhat IS NULL)
FROM tabfm_classify('t', 'label', features := ['f1','f2','f3','f4','f5'], model := 'causilo-fixture')
----
20	12	0

# the exact predicted label for ALL 20 rows, context and query alike. The result carries the
# selected feature columns but not `id`, so rows are matched on their five feature values (exact
# quarter-multiples, unique per row; the first query asserts that, so a duplicate cannot hide).
statement ok
CREATE TABLE exp_cls AS SELECT t.f1, t.f2, t.f3, t.f4, t.f5, e.expected FROM t JOIN
  (VALUES (0,'c1'),(1,'c0'),(2,'c1'),(3,'c1'),(4,'c0'),(5,'c1'),(6,'c1'),(7,'c1'),(8,'c0'),(9,'c2'),
             (10,'c1'),(11,'c1'),(12,'c0'),(13,'c0'),(14,'c0'),(15,'c1'),(16,'c1'),(17,'c0'),(18,'c0'),(19,'c1'))
  e(id, expected) USING (id);

query II
SELECT count(*), count(DISTINCT (f1, f2, f3, f4, f5)) FROM exp_cls
----
20	20

query II
SELECT count(*), count(*) FILTER (WHERE a.yhat <> e.expected)
FROM tabfm_classify('t', 'label', features := ['f1','f2','f3','f4','f5'], model := 'causilo-fixture') a
JOIN exp_cls e ON a.f1 = e.f1 AND a.f2 = e.f2 AND a.f3 = e.f3 AND a.f4 = e.f4 AND a.f5 = e.f5
----
20	0

# the fixture predicts all three classes, so a model that collapsed to one label would fail above
query I
SELECT count(DISTINCT yhat)
FROM tabfm_classify('t', 'label', features := ['f1','f2','f3','f4','f5'], model := 'causilo-fixture')
----
3

# the context rows are real in-context values, not a pad: they are not one constant
query I
SELECT count(DISTINCT yhat)
FROM tabfm_classify('t', 'label', features := ['f1','f2','f3','f4','f5'], model := 'causilo-fixture')
WHERE is_training
----
3

# regression: RAW-space point estimate for ALL 20 rows (the graph standardises the targets and
# inverts the scaler itself, so the engine feeds raw targets and reads the output directly)
statement ok
CREATE TABLE r AS SELECT i AS id,
  ((i*7 + 0*3 + (i*0) % 5) % 11) * 0.25 - 1.0 AS f1,
  ((i*7 + 1*3 + (i*1) % 5) % 11) * 0.25 - 1.0 AS f2,
  ((i*7 + 2*3 + (i*2) % 5) % 11) * 0.25 - 1.0 AS f3,
  ((i*7 + 3*3 + (i*3) % 5) % 11) * 0.25 - 1.0 AS f4,
  ((i*7 + 4*3 + (i*4) % 5) % 11) * 0.25 - 1.0 AS f5,
  CASE WHEN i < 12 THEN ((i*37) % 17) * 0.25 - 2.0 END AS target
FROM range(20) r(i);

query III
SELECT count(*), count(*) FILTER (WHERE is_training), count(*) FILTER (WHERE yhat IS NULL)
FROM tabfm_regress('r', 'target', features := ['f1','f2','f3','f4','f5'], model := 'causilo-fixture')
----
20	12	0

statement ok
CREATE TABLE exp_reg AS SELECT r.f1, r.f2, r.f3, r.f4, r.f5, e.expected FROM r JOIN
  (VALUES (0,-0.107273),(1,-0.454478),(2,-0.058674),(3,-0.321952),(4,-0.335644),(5,-0.068704),
             (6,-0.394757),(7,-0.467472),(8,0.22688),(9,-0.385102),(10,0.038852),(11,-0.463639),
             (12,-0.523591),(13,-0.488534),(14,-0.278492),(15,-0.478234),(16,-0.496697),
             (17,-0.452946),(18,-0.43787),(19,0.181088))
  e(id, expected) USING (id);

query II
SELECT count(*), count(*) FILTER (WHERE abs(a.yhat - e.expected) > 1e-3)
FROM tabfm_regress('r', 'target', features := ['f1','f2','f3','f4','f5'], model := 'causilo-fixture') a
JOIN exp_reg e ON a.f1 = e.f1 AND a.f2 = e.f2 AND a.f3 = e.f3 AND a.f4 = e.f4 AND a.f5 = e.f5
----
20	0

# the fitted (context) values vary: a zero-padded context would decode to a single number
query I
SELECT count(DISTINCT round(yhat, 4))
FROM tabfm_regress('r', 'target', features := ['f1','f2','f3','f4','f5'], model := 'causilo-fixture')
WHERE is_training
----
12

# A missing feature cell is mean-imputed by the engine before the graph, so it is answered.
# (Causilo's own missing-value embedding is therefore unused; docs/REAL_MODELS.md says so.)
statement ok
CREATE TABLE tn AS SELECT id, CASE WHEN id = 14 THEN NULL ELSE f1 END AS f1, f2, f3, f4, f5, label FROM t;

query II
SELECT count(*), count(*) FILTER (WHERE yhat IS NULL)
FROM tabfm_classify('tn', 'label', features := ['f1','f2','f3','f4','f5'], model := 'causilo-fixture')
----
20	0

# error path: more classes than the model's head is a property of the model, and the message
# names the model, the count and where to look
statement ok
CREATE TABLE t4 AS SELECT id, f1, f2, f3, f4, f5,
  CASE WHEN id < 12 THEN 'k' || (id % 4) END AS label FROM t;

statement error
SELECT count(*) FROM tabfm_classify('t4', 'label', features := ['f1','f2','f3','f4','f5'], model := 'causilo-fixture')
----
supports at most 3 classes
