# name: test/sql/tabfm_tabpfn3.test
# description: TabPFN-3 (Prior Labs, released 2026-05-12) onboarded alongside
#              v2 and 2.5. Architecturally it is NOT 2.5 scaled up — a
#              distribution-embedding stack with inducing points feeds a
#              feature-aggregation stack, and RoPE replaces the pre-generated
#              column-embedding table — yet it needs NO engine change: the
#              exported contract is still (x, y) -> logits, so the engine's
#              y-as-train-prefix path drives it unchanged. The work was an
#              exporter change (tools/export_tabpfn --arch v3), which is the
#              whole claim this file exists to keep honest.
#
#              Uses the committed random-init fixture (offline, zero Prior Labs
#              weight bytes). Real-weight parity was 2.4e-07 classification /
#              2.4e-06 regression at export time.
#
#              v3 is licensed like 2.5, NOT like v2: tabpfn-3-license-v1.0
#              permits testing/evaluation/internal benchmarking only, so the
#              built-in entry is commercial:false + gated.
# group: [anofox_tabfm]

require anofox_tabfm

require notwindows

statement ok
LOAD anofox_tabfm

# --- the built-in catalog entry ------------------------------------------------

query TTT
SELECT model, family, capabilities FROM tabfm_list_models() WHERE model = 'tabpfn-v3'
----
tabpfn-v3	icl-transformer	classify, regress

# the three TabPFN generations, and their diverging licences
query TTT
SELECT model, license, commercial FROM tabfm_list_models()
WHERE model IN ('tabpfn-v2', 'tabpfn-v2-5', 'tabpfn-v3') ORDER BY model
----
tabpfn-v2	apache-2.0	true
tabpfn-v2-5	tabpfn-2.5-license-v1.1	false
tabpfn-v3	tabpfn-3-license-v1.0	false

# --- the fixture model (real forward pass, offline) ----------------------------

statement ok
CALL tabfm_register_model(
  id := 'tabpfn-v3-fixture', base_dir := 'test/fixtures/tabpfn3',
  classification_graph := 'graph_tabpfn3_classification.onnx',
  regression_graph := 'graph_tabpfn3_regression.onnx',
  classification_weights := 'model.safetensors',
  regression_weights := 'model_regression.safetensors',
  classification_tensor_map := 'tensor_map_tabpfn3_classification.json',
  regression_tensor_map := 'tensor_map_tabpfn3_regression.json',
  license := 'tabpfn-3-license-v1.0', commercial := false,
  preprocessing_profile := 'tabpfn_v3_raw',
  max_rows := 4096, max_features := 64, max_classes := 4)

query TTT
SELECT model, family, capabilities FROM tabfm_list_models() WHERE model = 'tabpfn-v3-fixture'
----
tabpfn-v3-fixture	icl-transformer	classify, regress

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,'c0'),(1.5,0.2,0.3,'c1'),(2.5,-1.0,0.5,'c2'),
  (0.2,0.8,0.7,'c0'),(1.1,0.4,0.2,'c1'),(3.0,-0.5,0.9,'c2'),
  (0.9,1.2,0.6,'c0'),(2.1,0.1,0.4,'c1'),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,label);

# a real forward pass through the v3 graph (RoPE positions, inducing points)
query II
SELECT count(*), count(*) FILTER (WHERE yhat NOT IN ('c0','c1','c2'))
FROM tabfm_classify('t', 'label', model := 'tabpfn-v3-fixture')
----
10	0

query I
SELECT count(*) FROM tabfm_classify('t', 'label', model := 'tabpfn-v3-fixture') WHERE yhat IS NULL
----
0

# the probability vector is a real distribution, not a constant fill
query I
SELECT count(*) FROM tabfm_classify('t', 'label', model := 'tabpfn-v3-fixture')
WHERE abs(list_sum(map_values(proba)) - 1.0) > 1e-5
----
0

# regression runs too — v3's regressor emits the same [1,T,1] RAW-space point
# estimate (bar-distribution mean, de-standardized in-graph) as v2 / 2.5
statement ok
CREATE TABLE r AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,1.2),(1.5,0.2,0.3,2.4),(2.5,-1.0,0.5,3.1),
  (0.2,0.8,0.7,0.9),(1.1,0.4,0.2,1.8),(3.0,-0.5,0.9,3.6),
  (0.9,1.2,0.6,1.1),(2.1,0.1,0.4,2.7),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,target);

query II
SELECT count(*), count(*) FILTER (WHERE yhat IS NULL)
FROM tabfm_regress('r', 'target', model := 'tabpfn-v3-fixture')
----
10	0

# --- generation works on v3 too ------------------------------------------------
# tabfm_generate sits above the engine seam, so a newly onboarded model gets it
# for free. This is the check that the claim holds for a model added AFTER the
# generation surface was written.

query II
SELECT count(*), count(*) FILTER (WHERE f1 IS NULL OR label IS NULL)
FROM tabfm_generate('t', 8, model := 'tabpfn-v3-fixture', opts := MAP{'seed':'42'})
----
8	0

query I
SELECT count(*) FROM tabfm_generate('t', 12, model := 'tabpfn-v3-fixture')
WHERE label NOT IN ('c0','c1','c2') OR f1 < 0.2 OR f1 > 3.0
----
0
