# Categorical and NULL features go through the same preprocessing as without the cache: cache vs kill
# switch on every row, then a hit on the repeat.
statement ok
CREATE TABLE mixed AS SELECT * FROM (VALUES
  (0.5, 'red',   NULL, 'c0'), (1.5, 'blue',  0.3, 'c1'), (2.5, 'red',   0.5, 'c2'),
  (0.2, NULL,    0.7, 'c0'), (1.1, 'green', 0.2, 'c1'), (3.0, 'blue',  NULL, 'c2'),
  (0.9, 'red',   0.6, 'c0'), (2.1, 'green', 0.4, 'c1'),
  (1.3, 'blue',  0.35, NULL), (2.4, NULL,  NULL, NULL))
  v(f1, colour, f3, label);

statement ok
SET anofox_tabfm_context_cache = false

statement ok
CREATE TABLE mixed_off AS SELECT f1, yhat, yhat_score FROM tabfm_classify('mixed', 'label', model := 'tabicl-kv-fixture');

statement ok
RESET anofox_tabfm_context_cache

statement ok
CREATE TABLE mixed_on AS SELECT f1, yhat, yhat_score FROM tabfm_classify('mixed', 'label', model := 'tabicl-kv-fixture');

query II
SELECT count(*), count(*) FILTER (WHERE o.yhat <> c.yhat OR abs(o.yhat_score - c.yhat_score) > 1e-6)
FROM mixed_off o JOIN mixed_on c USING (f1)
