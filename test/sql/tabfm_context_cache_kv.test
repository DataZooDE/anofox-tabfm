# ---------------------------------------------------------------------------
# Parallel groups: one context per group, scored by the predict aggregate in parallel finalize threads.
# threads = 4 must give exactly what threads = 1 gives -- first on a cold cache, then warm.

statement ok
CALL tabfm_unload()

statement ok
CREATE TABLE segs AS SELECT i % 12 AS seg, (i % 7) * 0.3 + (i % 12) * 0.05 AS f1, (i % 5) * 0.2 AS f2,
  (i % 3) * 0.25 AS f3, CASE WHEN i < 480 THEN 'c' || ((i // 12) % 3) END AS label
FROM range(600) r(i);

statement ok
SET threads = 1

statement ok
CREATE TABLE seq AS SELECT seg, __anofox_tabfm_predict_agg({'f1': f1, 'f2': f2, 'f3': f3, 'label': label}, 'label',
  MAP{'model': 'tabicl-kv-fixture', 'task': 'classification'}) AS res FROM segs GROUP BY seg;

statement ok
CALL tabfm_unload()

statement ok
SET threads = 4

statement ok
CREATE TABLE par_cold AS SELECT seg, __anofox_tabfm_predict_agg({'f1': f1, 'f2': f2, 'f3': f3, 'label': label}, 'label',
  MAP{'model': 'tabicl-kv-fixture', 'task': 'classification'}) AS res FROM segs GROUP BY seg;

statement ok
CREATE TABLE par_warm AS SELECT seg, __anofox_tabfm_predict_agg({'f1': f1, 'f2': f2, 'f3': f3, 'label': label}, 'label',
  MAP{'model': 'tabicl-kv-fixture', 'task': 'classification'}) AS res FROM segs GROUP BY seg;

query III
SELECT count(*), count(*) FILTER (WHERE s.res IS DISTINCT FROM c.res), count(*) FILTER (WHERE s.res IS DISTINCT FROM w.res)
FROM seq s JOIN par_cold c USING (seg) JOIN par_warm w USING (seg)
----
12	0	0

query IIII
SELECT context_entries, context_hits, context_misses, context_hits + context_misses
FROM tabfm_models() WHERE model = 'tabicl-kv-fixture' AND task = 'classification' AND loaded AND context_cache
----
12	12	12	24

