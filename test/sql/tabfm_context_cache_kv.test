# A budget of '0' keeps nothing, end to end; a context over the budget is encoded ONCE per call even with
# query_batch (one miss for the whole call), and the answers are unchanged.
statement ok
CALL tabfm_unload()

statement ok
SET anofox_tabfm_context_cache_memory = '0'

query I
