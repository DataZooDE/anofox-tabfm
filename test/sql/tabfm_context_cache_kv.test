JOIN (SELECT id, yhat, yhat_score FROM tabfm_classify('q', 'label', features := ['f1', 'f2', 'f3'], model := 'tabicl-kv-fixture',
      opts := MAP{'query_batch': '4'}) JOIN q USING (f1, f2, f3)) b USING (id)
WHERE w.yhat <> b.yhat OR w.yhat_score <> b.yhat_score
