# --- TabDPT v1.2: ONE file serves both tasks, so the second download is a cache hit ---
# 0.88 / 0.899 measured

query T
SELECT parse_filename(file) || ' ' || bytes || ' ' || status FROM tabfm_download('classification', model := 'tabdpt') ORDER BY 1
----
model.safetensors 254098072 downloaded

query T
SELECT parse_filename(file) || ' ' || bytes || ' ' || status FROM tabfm_download('regression', model := 'tabdpt') ORDER BY 1
----
model.safetensors 254098072 cached

query T
SELECT avg(CASE WHEN p.yhat = t.y THEN 1 ELSE 0 END) >= 0.85
FROM tabfm_classify('ctx', 'y', test := 'qry', model := 'tabdpt') p JOIN t USING (row_id)
----
true

query T
SELECT corr(p.yhat, 2 * t.a + 0.5 * t.c) > 0.85
FROM tabfm_regress('rctx', 'target', test := 'rqry', model := 'tabdpt') p JOIN t USING (row_id)
----
true

