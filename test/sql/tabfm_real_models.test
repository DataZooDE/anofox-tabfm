# More than 10 classes: upstream reaches them with error-correcting output codes, which the engine does
# not reproduce, so the head width is the ceiling and the refusal names the model and the fix.
statement ok
CREATE TABLE k11 AS SELECT i::DOUBLE f1, (i % 7)::DOUBLE f2, CASE WHEN i < 80 THEN 'k' || (i % 11)::VARCHAR END AS lbl
FROM range(100) r(i);

statement error
SELECT count(*) FROM tabfm_classify('k11', 'lbl', model := 'kumo-tabular-small')
----
'kumo-tabular-small' supports at most 10 classes and 'lbl' has 11

# ---------------------------------------------------------------------------
# tabfm_download writes the GPU weights of the checkpoint-shipped models itself: the model.safetensors
# beside the .ckpt that the bundled ext/migraphx graphs read by offset (it used to need
# tools/export_*/convert_*_weights). A second row reports it: 'converted' when written now, 'cached' when
# a file with the pinned header is already there.
query TT
SELECT parse_filename(file), status IN ('converted', 'cached') FROM tabfm_download('regression', model := 'nori-30m')
ORDER BY 1
----
model.ckpt	true
model.safetensors	true

query TT
SELECT parse_filename(file), status IN ('converted', 'cached') FROM tabfm_download('classification', model := 'kumo-tabular-small')
ORDER BY 1
----
model.ckpt	true
model.safetensors	true
