query I
SELECT count(DISTINCT yhat) > 1 FROM tabfm_classify('fitted_t', 'label', model := 'kumo-tabular-small')
WHERE is_training;
----
true

query I
SELECT corr(yhat, target) > 0.9
FROM tabfm_regress('reg_t', 'target', model := 'kumo-tabular-small') WHERE is_training;
----
true

query I
SELECT corr(yhat, f1 * 0.7 + 3) > 0.99
FROM tabfm_regress('reg_in', 'target', model := 'kumo-tabular-small') WHERE NOT is_training;
----
true

statement ok
CREATE TABLE c_km AS
SELECT row_id, yhat FROM tabfm_classify('ctx_cls', 'y', test := 'qry', model := 'kumo-tabular-medium');

query I
SELECT count(*) FROM c_km WHERE yhat IS NULL
----
0

query I
SELECT (SELECT count(*) FILTER (WHERE c.yhat = t.y) FROM c_km c JOIN truth t USING (row_id)) * 1.0
       / (SELECT count(*) FROM truth) >= 0.90
----
true

statement ok
CREATE TABLE r_km AS
SELECT row_id, yhat FROM tabfm_regress('ctx_reg', 'tgt', test := 'qry', model := 'kumo-tabular-medium');

query I
SELECT 1 - sum(power(r.yhat - t.tgt, 2)) / sum(power(t.tgt - (SELECT avg(tgt) FROM truth), 2)) >= 0.95
FROM r_km r JOIN truth t USING (row_id)
----
true

query I
SELECT sum(CASE WHEN yhat = label THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.9
FROM tabfm_classify('sep_t', 'label', model := 'kumo-tabular-medium') WHERE is_training;
----
true

query I
SELECT sum(CASE WHEN yhat = 'c' || round(f1 / 10)::INTEGER THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.9
FROM tabfm_classify('sep_t', 'label', model := 'kumo-tabular-medium') WHERE NOT is_training;
----
true

