query I
SELECT corr(yhat, target) > 0.9
FROM tabfm_regress('reg_t', 'target', model := 'tabpfn-v3-5-fast') WHERE is_training;
----
true

# raw-in / raw-out: the regression graph de-standardises its own output, so the
# estimates sit on the target's scale (3 .. 58.3 over the context rows)
query I
SELECT min(yhat) > 0 AND max(yhat) < 70
FROM tabfm_regress('reg_t', 'target', model := 'tabpfn-v3-5') WHERE is_training;
----
true

# ---------------------------------------------------------------------------
# Nori-30M (Synthefy): REGRESSION ONLY, query rows AND context rows, from the natively read nori.pt.
#
# Like LimiX-2M (its ancestor) the context rows come from a second pass (the context presented again as
# queries), so both halves are checked. The model standardises its own features and the wrapper
# standardises the target in-graph and reduces the 999-quantile head to its mean, so the engine must do
# neither (profile nori_v1_raw).
#
# Parity with upstream's single forward is exercised out-of-band (tools/export_nori/tests/
# test_real_weights.py and docs/REAL_MODELS.md): the built-in path agrees with upstream eager to 1.0e-4
# on a 1000-row california_housing sample (query R2 0.7917 both) and to 9.4e-2 on diabetes (target std 71;
# 1e-7 relative input noise moves upstream's own eager forward by 7.7e-2 there). It is a SINGLE forward,
# not upstream's 8-member NoriRegressor ensemble.
#
# Measured on these tables (CPU): shared split query R2 0.99982; reg_t context corr 0.99997, query
# corr(yhat, f1) 0.9955 with predictions reaching 74.2 against a truth of 72.3 (it extrapolates, unlike
# LimiX-2M); reg_in query corr 0.99996, worst error 0.44.

statement ok
CREATE TABLE r_nori AS
SELECT row_id, yhat FROM tabfm_regress('ctx_reg', 'tgt', test := 'qry', model := 'nori-30m');

query I
SELECT count(*) FROM r_nori WHERE yhat IS NULL
----
0

query I
SELECT 1 - sum(power(r.yhat - t.tgt, 2)) / sum(power(t.tgt - (SELECT avg(tgt) FROM truth), 2)) >= 0.95
FROM r_nori r JOIN truth t USING (row_id)
----
true

query I
SELECT corr(yhat, target) > 0.99
FROM tabfm_regress('reg_t', 'target', model := 'nori-30m') WHERE is_training;
----
true

query I
SELECT corr(yhat, f1) > 0.98
FROM tabfm_regress('reg_t', 'target', model := 'nori-30m') WHERE NOT is_training;
----
true

query I
SELECT corr(yhat, f1 * 0.7 + 3) > 0.999 AND max(abs(yhat - (f1 * 0.7 + 3))) < 1.5
FROM tabfm_regress('reg_in', 'target', model := 'nori-30m') WHERE NOT is_training;
----
true

# Regression only, with the weights on disk too: classification is refused, naming models that classify.
statement error
