# v1.2 and v1.3 live in the SAME repo slug (Layer6__TabDPT@main): v1.3's file is tabdpt1_3/ so the
# two can never overwrite each other. If they did, one entry would serve the other's weights.
query I
SELECT max(abs(a.yhat - b.yhat)) > 1e-6
FROM r_dpt a JOIN r_dpt13 b USING (row_id)
----
true

# The in-context fitted values are real for v1.3 too (the head runs over every data row).
query I
SELECT sum(CASE WHEN yhat = label THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.7
FROM tabfm_classify('sep_t', 'label', model := 'tabdpt-v1-3') WHERE is_training;
----
true

query I
SELECT corr(yhat, target) > 0.9
FROM tabfm_regress('reg_t', 'target', model := 'tabdpt-v1-3') WHERE is_training;
----
true

# ---------------------------------------------------------------------------
# TabPFN-3.5 and TabPFN-3.5-Fast (Prior Labs). One published safetensors per
# variant serves both tasks with no conversion, and each task's graph uses only
# its own head -- so these are also the check that the engine injects exactly
# what each map names (tensor maps marked "complete") rather than offering ORT
# the other head. Measured on this split (CPU): 3.5 acc 0.969 / R^2 0.99997,
# 3.5-Fast acc 0.953 / R^2 0.99993; fitted and query accuracy on sep_t 1.0, fitted
# regression corr 0.999998 (the duplicate route; the embedding route measured
# 0.65-0.86 on real weights and is not used for regression).

statement ok
SET anofox_tabfm_device = 'cpu';

statement ok
CREATE TABLE c_35 AS
SELECT row_id, yhat FROM tabfm_classify('ctx_cls', 'y', test := 'qry', model := 'tabpfn-v3-5');

query I
SELECT (SELECT count(*) FILTER (WHERE c.yhat = t.y) FROM c_35 c JOIN truth t USING (row_id)) * 1.0
       / (SELECT count(*) FROM truth) >= 0.90
----
true

