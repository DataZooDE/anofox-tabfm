# name: test/sql/tabfm_real_models.test
# description: REAL-WEIGHT tests for the models onboarded from the TabArena
#              v0.1.4 board (RealTabPFN-2.5 and TabPFN-2.6), plus the 2.5 entry
#              they are compared against.
#
#              Every other *.test here runs the committed random-init fixtures:
#              that proves the graph loads and the engine drives it, but a
#              random-init model cannot tell a correct weight mapping from a
#              scrambled one — it predicts noise either way. This file is the
#              complement: it runs the ACTUAL published checkpoints and asserts
#              they are actually good at a learnable task.
#
#              It is opt-in because most of these weights are gated,
#              non-commercial and 40-250 MB each, so CI must not fetch them (and
#              the licence wall forbids committing them).
#
#              Every model asserted below needs its weights staged first — a
#              missing artifact fails as "no downloaded weights", which looks
#              nothing like the accuracy regression this file exists to catch.
#              The full set:
#
#                # TabPFN 2.5 (the baseline the -real entry is compared against),
#                # 2.5-real and 2.6 — all Prior Labs .ckpt, so all need the
#                # one-time converter. --variant=real writes to <task>-real/ so it
#                # cannot overwrite the default checkpoint of the same repo.
#                cd tools/export_tabpfn
#                for t in classification regression; do
#                  uv run python convert_weights.py $t --arch=v2.5
#                  uv run python convert_weights.py $t --arch=v2.5 --variant=real
#                  uv run python convert_weights.py $t --arch=v2.6
#                done
#
#                # Orion-MSP: .ckpt too, classification only.
#                cd ../export_orion_msp && uv run python convert_weights.py
#
#                # TabDPT needs NO converter — Layer 6 publish safetensors whose
#                # keys are already the model's namespace. One file, both tasks:
#                CALL tabfm_download('classification', model := 'tabdpt');
#
#                # Causilo needs NO converter either -- Nums AI publish safetensors whose
#                # keys are already the model's namespace, and the repo is ungated:
#                CALL tabfm_download('classification', model := 'causilo');
#                CALL tabfm_download('regression', model := 'causilo');
#
#                # LimiX-2M needs NO converter either: the engine's native reader takes the .ckpt (the
#                # nested {"config", "state_dict"} pickle) directly. ONE 9.5 MB file serves both tasks:
#                CALL tabfm_download('classification', model := 'limix-2m');
#
#                # Google TabFM 1.1.0 needs NO converter: Google publish safetensors (BF16, which the
#                # engine upcasts) whose keys are the model's namespace. Ungated repo, non-commercial
#                # licence; 0.82 GB per task:
#                CALL tabfm_download('classification', model := 'tabfm-v1-1');
#                CALL tabfm_download('regression', model := 'tabfm-v1-1');
#
#                # TabPFN-3.5 / 3.5-Fast need NO converter: Prior Labs publish safetensors under the
#                # model's own names. ONE file per variant serves both tasks (876 MB / 334 MB):
#                CALL tabfm_download('classification', model := 'tabpfn-v3-5');
#                CALL tabfm_download('classification', model := 'tabpfn-v3-5-fast');
#
#                # Nori-30M (Synthefy, Apache-2.0, ungated) needs NO converter either: the engine reads
#                # nori.pt ({model_config, ema_state_dict}) natively. Regression only:
#                CALL tabfm_download('regression', model := 'nori-30m');
#
#                # EXAONE Tabular (LG AI Research, non-commercial EXAONE NC 1.2 weights; the HF repo is
#                # ungated) needs NO converter: LG publish safetensors keyed by the module namespace. One
#                # file per task:
#                CALL tabfm_download('classification', model := 'exaone-tabular');
#                CALL tabfm_download('regression', model := 'exaone-tabular');
#
#                # Kumo-Tabular (NVIDIA, OpenMDW-1.1, ungated) needs NO converter on the CPU: the engine's
#                # native reader takes the published .pt state_dict. Six files, three sizes x two tasks:
#                CALL tabfm_download('classification', model := 'kumo-tabular-small');   -- and regression,
#                -- and the same for kumo-tabular-medium and kumo-tabular-large
#
#                TABFM_REAL_WEIGHTS=1 ./build/debug/test/unittest test/sql/tabfm_real_models.test
# group: [anofox_tabfm]

require anofox_tabfm

require notwindows

require-env TABFM_REAL_WEIGHTS

statement ok
LOAD anofox_tabfm

# The 2.5 line and 2.6 are non-commercial + gated: without this every query
# below fails on the licence gate rather than on model quality.
statement ok
SET anofox_tabfm_accept_hf_license = true

# A learnable, deterministic task. Hash-split rather than positionally split:
# a positional split of a periodic series puts context and query in different
# phase regions and drives accuracy to chance for reasons that have nothing to
# do with the weights (the lesson recorded in tools/gpu_test/scenarios).
statement ok
CREATE TABLE base AS
SELECT i AS row_id,
       sin(i * 0.11) f1, cos(i * 0.07) f2, (i % 13) / 13.0 f3, ln(1 + (i % 31)) f4,
       CASE WHEN sin(i * 0.11) + 0.5 * cos(i * 0.07) >  0.3 THEN 'a'
            WHEN sin(i * 0.11) + 0.5 * cos(i * 0.07) > -0.3 THEN 'b' ELSE 'c' END AS y,
       sin(i * 0.11) * 5 + cos(i * 0.07) * 2 AS tgt
FROM range(240) t(i);

# Both sides expose exactly the same columns: row_id plus the four features, and
# each context table adds only its own label. That symmetry is now enforced —
# tabfm_classify/tabfm_regress raise when the two relations disagree (see
# test/sql/tabfm_feature_mismatch.test) — but it matters here for a second
# reason: a column on one side only is filled with NULL on the other and drags
# the prediction toward chance, which is precisely what these accuracy floors
# exist to detect. `row_id` is carried on BOTH sides rather than dropped,
# because the queries below join predictions back to `truth` on it.
statement ok
CREATE TABLE ctx_cls AS SELECT row_id, f1, f2, f3, f4, y FROM base WHERE hash(row_id) % 100 < 70;

statement ok
CREATE TABLE ctx_reg AS SELECT row_id, f1, f2, f3, f4, tgt FROM base WHERE hash(row_id) % 100 < 70;

statement ok
CREATE TABLE qry AS SELECT row_id, f1, f2, f3, f4 FROM base WHERE hash(row_id) % 100 >= 70;

statement ok
CREATE TABLE truth AS SELECT row_id, y, tgt FROM base WHERE hash(row_id) % 100 >= 70;

# --- RealTabPFN-2.5 -----------------------------------------------------------
#
# The load-bearing assertion for WS1: this entry reuses 2.5's bundled graph and
# tensor map, and its weights come from a DIFFERENT checkpoint in the SAME HF
# repo. If the cache paths collided, or the real checkpoint did not populate the
# 2.5 tensor map, the model would still "run" — it would just predict badly.
# Only an accuracy floor catches that, which is the whole point of this file.

statement ok
CREATE TABLE c_real25 AS
SELECT row_id, yhat FROM tabfm_classify('ctx_cls', 'y', test := 'qry', model := 'tabpfn-v2-5-real');

query I
SELECT count(*) FROM c_real25 WHERE yhat IS NULL
----
0

# A correctly-wired real checkpoint scores far above chance (3 classes ⇒ ~0.33).
query I
SELECT (SELECT count(*) FILTER (WHERE c.yhat = t.y) FROM c_real25 c JOIN truth t USING (row_id)) * 1.0
       / (SELECT count(*) FROM truth) >= 0.90
----
true

statement ok
CREATE TABLE r_real25 AS
SELECT row_id, yhat FROM tabfm_regress('ctx_reg', 'tgt', test := 'qry', model := 'tabpfn-v2-5-real');

# R^2 well above zero. A scrambled tensor mapping lands at or below 0 here.
query I
SELECT 1 - sum(power(r.yhat - t.tgt, 2)) / sum(power(t.tgt - (SELECT avg(tgt) FROM truth), 2)) >= 0.80
FROM r_real25 r JOIN truth t USING (row_id)
----
true

# --- TabPFN-2.6 ---------------------------------------------------------------

statement ok
CREATE TABLE c_26 AS
SELECT row_id, yhat FROM tabfm_classify('ctx_cls', 'y', test := 'qry', model := 'tabpfn-v2-6');

query I
SELECT count(*) FROM c_26 WHERE yhat IS NULL
----
0

query I
SELECT (SELECT count(*) FILTER (WHERE c.yhat = t.y) FROM c_26 c JOIN truth t USING (row_id)) * 1.0
       / (SELECT count(*) FROM truth) >= 0.90
----
true

statement ok
CREATE TABLE r_26 AS
SELECT row_id, yhat FROM tabfm_regress('ctx_reg', 'tgt', test := 'qry', model := 'tabpfn-v2-6');

query I
SELECT 1 - sum(power(r.yhat - t.tgt, 2)) / sum(power(t.tgt - (SELECT avg(tgt) FROM truth), 2)) >= 0.80
FROM r_26 r JOIN truth t USING (row_id)
----
true

# --- TabDPT -------------------------------------------------------------------
#
# Apache-2.0 and ungated, so no licence acceptance is involved here. This is also
# the only entry whose two tasks read the SAME cached file, and the only one with
# no ckpt->safetensors conversion step: if the published safetensors did not
# populate the committed tensor map, these two assertions are what would notice.

statement ok
CREATE TABLE c_dpt AS
SELECT row_id, yhat FROM tabfm_classify('ctx_cls', 'y', test := 'qry', model := 'tabdpt');

query I
SELECT count(*) FROM c_dpt WHERE yhat IS NULL
----
0

query I
SELECT (SELECT count(*) FILTER (WHERE c.yhat = t.y) FROM c_dpt c JOIN truth t USING (row_id)) * 1.0
       / (SELECT count(*) FROM truth) >= 0.90
----
true

statement ok
CREATE TABLE r_dpt AS
SELECT row_id, yhat FROM tabfm_regress('ctx_reg', 'tgt', test := 'qry', model := 'tabdpt');

query I
SELECT 1 - sum(power(r.yhat - t.tgt, 2)) / sum(power(t.tgt - (SELECT avg(tgt) FROM truth), 2)) >= 0.80
FROM r_dpt r JOIN truth t USING (row_id)
----
true

# --- Orion-MSP ----------------------------------------------------------------
#
# Classification only. The frozen attention mask is the thing worth checking on
# REAL weights: upstream redraws those links every forward, so if the freeze had
# not taken, this model would score differently on each run and the repeat check
# below would flake rather than fail cleanly.

statement ok
CREATE TABLE c_msp AS
SELECT row_id, yhat FROM tabfm_classify('ctx_cls', 'y', test := 'qry', model := 'orion-msp');

query I
SELECT count(*) FROM c_msp WHERE yhat IS NULL
----
0

query I
SELECT (SELECT count(*) FILTER (WHERE c.yhat = t.y) FROM c_msp c JOIN truth t USING (row_id)) * 1.0
       / (SELECT count(*) FROM truth) >= 0.85
----
true

# Deterministic across runs, with the real checkpoint's row_num_random = 2 live.
query I
SELECT count(*) FROM c_msp a
JOIN (SELECT row_id, yhat FROM tabfm_classify('ctx_cls', 'y', test := 'qry', model := 'orion-msp')) b
  USING (row_id)
WHERE a.yhat IS DISTINCT FROM b.yhat
----
0

# --- the two 2.5 checkpoints are genuinely DIFFERENT weights -------------------
#
# 2.5 and 2.5-real share a graph and a tensor map, so a cache-path collision (or
# a copy-pasted URL) would leave both entries serving the SAME bytes and every
# assertion above would still pass. Predictions from continued pre-training on
# real data must not be identical to the synthetic-only ones.
#
# The comparison is on REGRESSION output, not class labels: two good models
# agree on nearly every label of an easy 3-class task, so a label-difference
# check would be flaky. Continuous point estimates from different weights
# effectively never coincide to the bit.

statement ok
CREATE TABLE r_25 AS
SELECT row_id, yhat FROM tabfm_regress('ctx_reg', 'tgt', test := 'qry', model := 'tabpfn-v2-5');

query I
SELECT max(abs(a.yhat - b.yhat)) > 1e-6
FROM r_25 a JOIN r_real25 b USING (row_id)
----
true

# is_training rows must carry REAL in-context fitted values, not a placeholder.
#
# Regression: tabdpt's export ran the head over query rows only and the wrapper
# zero-padded the context rows, so every training row decoded to argmax(zeros)
# -- one constant label for the whole context. README describes this column as
# "in-context fitted values, handy for a sanity check"; it was neither fitted
# nor a sanity check. Found by comparing the CPU path against the masked ROCm
# graph, which computes the head over all rows.
#
# A model that genuinely predicts one class everywhere would also produce 1
# here, so the data below is built with three well-separated classes.
# (the file already declares require-env TABFM_REAL_WEIGHTS at the top; a
# second one mid-file is a PARSER error, not a no-op)

statement ok
SET anofox_tabfm_device = 'cpu';

statement ok
CREATE TABLE fitted_t AS
SELECT i AS f1, (i % 7)::DOUBLE AS f2, ((i * 13) % 5)::DOUBLE AS f3,
       CASE WHEN i < 80 THEN ('c' || (i % 3)) ELSE NULL END AS label
FROM range(100) s(i);

# Oracle 1: the column carries more than one value at all. Necessary, and far
# from sufficient -- noise passes it.
query I
SELECT count(DISTINCT yhat) > 1 FROM tabfm_classify('fitted_t', 'label', model := 'tabdpt')
WHERE is_training;
----
true

# Oracle 2: the real one. On SEPARABLE data an in-context fit should mostly
# recover the labels it was given. A zero pad scores ~1/3 here (it answers one
# class for everything); noise scores ~1/3 too. Requiring a majority
# distinguishes a genuine fit from either, which "> 1 distinct" cannot.
statement ok
CREATE TABLE sep_t AS
SELECT (i % 3)::DOUBLE * 10.0 + (i % 5) * 0.01 AS f1,
       (i % 3)::DOUBLE * -7.0 AS f2,
       CASE WHEN i < 80 THEN ('c' || (i % 3)) ELSE NULL END AS label
FROM range(100) s(i);

query I
SELECT sum(CASE WHEN yhat = label THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.7
FROM tabfm_classify('sep_t', 'label', model := 'tabdpt') WHERE is_training;
----
true

query I
SELECT count(DISTINCT yhat) > 1 FROM tabfm_classify('fitted_t', 'label', model := 'tabicl-v2')
WHERE is_training;
----
true

# Oracle 3: regression was untested entirely. A zero pad decodes to a constant,
# so correlating the fitted values against the targets separates a real fit from
# one. Pearson r over the context rows, not an exact-match count, because these
# are continuous.
statement ok
CREATE TABLE reg_t AS
SELECT i::DOUBLE AS f1, (i % 7)::DOUBLE AS f2,
       CASE WHEN i < 80 THEN (i * 0.7 + 3)::DOUBLE ELSE NULL END AS target
FROM range(100) s(i);

query I
SELECT corr(yhat, target) > 0.9
FROM tabfm_regress('reg_t', 'target', model := 'tabdpt') WHERE is_training;
----
true

# ---------------------------------------------------------------------------
# The same defect across the whole TabPFN family.
#
# tabdpt's fix above covered tabdpt. Measuring the rest with the same oracles
# found every TabPFN generation doing it too -- v2, v2.5, v2.6 AND v3, both
# tasks -- not just v2-6 as the tabdpt commit recorded. On the separable data
# below, where chance is 1/3 and mitra and tabicl-v2 both score 1.0:
#
#   tabpfn-v2  1 distinct, acc 0.338      tabpfn-v2-6  1 distinct, acc 0.338
#   tabpfn-v2-5  1 distinct, acc 0.338    tabpfn-v3    1 distinct, acc 0.338
#
# One cause for all of them: the shared ExportWrapper ran the model's head over
# query rows only and zero-padded the context rows to restore the shape.
#
# The accuracy oracle is the load-bearing one. "> 1 distinct" is necessary but
# weak -- noise passes it -- while a zero pad answers a single class everywhere
# and so scores ~1/3, which a majority requirement rejects.

query I
SELECT sum(CASE WHEN yhat = label THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.7
FROM tabfm_classify('sep_t', 'label', model := 'tabpfn-v2') WHERE is_training;
----
true

query I
SELECT sum(CASE WHEN yhat = label THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.7
FROM tabfm_classify('sep_t', 'label', model := 'tabpfn-v2-5') WHERE is_training;
----
true

query I
SELECT sum(CASE WHEN yhat = label THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.7
FROM tabfm_classify('sep_t', 'label', model := 'tabpfn-v2-6') WHERE is_training;
----
true

query I
SELECT sum(CASE WHEN yhat = label THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.7
FROM tabfm_classify('sep_t', 'label', model := 'tabpfn-v3') WHERE is_training;
----
true

# Regression: a constant column makes corr() return NaN rather than a small
# number, so `> 0.9` is false either way -- but assert non-constancy separately
# so a failure says WHICH of the two happened.
query I
SELECT count(DISTINCT yhat) > 1 FROM tabfm_regress('reg_t', 'target', model := 'tabpfn-v2')
WHERE is_training;
----
true

query I
SELECT corr(yhat, target) > 0.9
FROM tabfm_regress('reg_t', 'target', model := 'tabpfn-v2') WHERE is_training;
----
true

query I
SELECT corr(yhat, target) > 0.9
FROM tabfm_regress('reg_t', 'target', model := 'tabpfn-v2-6') WHERE is_training;
----
true

# ---------------------------------------------------------------------------
# Causilo (Nums AI): the first block here that also checks the QUERY rows.
#
# Every oracle above reads is_training rows, because that is where the constant-pad defect
# lived. Causilo's context rows come from a second pass (the context presented again as queries),
# so a regression could break the query rows instead, which those oracles cannot see. On sep_t the
# true class of every row is recoverable from f1 (round(f1 / 10) = i % 3), including the 20 query
# rows whose label is NULL.
#
# Parity with upstream is exercised out-of-band, where upstream's own estimator is available:
# tools/export_causilo/tests/test_real_weights.py (n_estimators=1; probabilities within 1e-4).
# The engine's default softmax_temperature is 0.9 for every model, which sharpens probabilities
# relative to Causilo's own temperature of 1; labels are unaffected.

query I
SELECT sum(CASE WHEN yhat = label THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.9
FROM tabfm_classify('sep_t', 'label', model := 'causilo') WHERE is_training;
----
true

query I
SELECT sum(CASE WHEN yhat = 'c' || round(f1 / 10)::INTEGER THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.9
FROM tabfm_classify('sep_t', 'label', model := 'causilo') WHERE NOT is_training;
----
true

query I
SELECT count(DISTINCT yhat) > 1 FROM tabfm_classify('fitted_t', 'label', model := 'causilo')
WHERE is_training;
----
true

query I
SELECT corr(yhat, target) > 0.9
FROM tabfm_regress('reg_t', 'target', model := 'causilo') WHERE is_training;
----
true

query I
SELECT corr(yhat, f1) > 0.9
FROM tabfm_regress('reg_t', 'target', model := 'causilo') WHERE NOT is_training;
----
true

# ---------------------------------------------------------------------------
# LimiX-2M (StableAI): query rows AND context rows, both tasks, from ONE downloaded checkpoint.
#
# Like Causilo its context rows come from a second pass (the context presented again as queries), so a
# regression could break the query rows while the context rows stay right, or the reverse: both are checked.
# The model standardises its own features and the wrapper standardises the regression target in-graph, so
# the engine must do neither (profile limix_v1_raw); a double normalisation would pass a "non-NULL" check and
# fail these floors.
#
# Parity with upstream's single forward is exercised out-of-band, where upstream's own model is available
# (tools/export_limix/tests/test_real_weights.py): on a held-out split the engine agreed with upstream eager on
# 45/45 iris and 54/54 wine labels, and on diabetes within 3.8e-2 absolute on a target spread of ~220.
# It is a SINGLE forward, not the ensemble upstream's leaderboard figures come from.

query I
SELECT sum(CASE WHEN yhat = label THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.9
FROM tabfm_classify('sep_t', 'label', model := 'limix-2m') WHERE is_training;
----
true

query I
SELECT sum(CASE WHEN yhat = 'c' || round(f1 / 10)::INTEGER THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.9
FROM tabfm_classify('sep_t', 'label', model := 'limix-2m') WHERE NOT is_training;
----
true

query I
SELECT count(DISTINCT yhat) > 1 FROM tabfm_classify('fitted_t', 'label', model := 'limix-2m')
WHERE is_training;
----
true

query I
SELECT corr(yhat, target) > 0.9
FROM tabfm_regress('reg_t', 'target', model := 'limix-2m') WHERE is_training;
----
true

# reg_t's 20 query rows (f1 80..99) lie BEYOND the training range (0..79), and LimiX-2M saturates there
# rather than extrapolating: on this table its predictions span 59.2..64.7 where the truth runs to 72.3.
# That is the model, not the engine: upstream's own eager forward gives the identical range and the identical
# correlation (0.8307, measured), so the floor below is a bound on a known behaviour, not a quality claim.
query I
SELECT corr(yhat, f1) > 0.8
FROM tabfm_regress('reg_t', 'target', model := 'limix-2m') WHERE NOT is_training;
----
true

# The accuracy oracle for this model is interpolation: the same linear target with the query rows scattered
# INSIDE the training range (every 5th row, offset 3). Upstream eager measures corr 0.9998 and a worst error of
# 0.99 on a target spanning 3..72.
#
# The offset is chosen on purpose. With the holdout at i % 5 = 4 the training mean of f1 is exactly 49.0, so the
# row f1 = 49 standardises to EXACTLY 0.0, which LimiX's decimal tokenizer encodes as its own token, and the
# model gets that one row badly wrong (25.1 against a truth of 37.3) while its neighbours at z = +-0.17 are off
# by 0.3-0.4. Upstream's eager forward does the same on the identical table, so it is the model's behaviour, not
# the engine's (tools/export_limix/tests/test_real_weights.py pins it; docs/REAL_MODELS.md says so).
statement ok
CREATE TABLE reg_in AS
SELECT i::DOUBLE AS f1, (i % 7)::DOUBLE AS f2,
       CASE WHEN i % 5 <> 3 THEN (i * 0.7 + 3)::DOUBLE ELSE NULL END AS target
FROM range(100) s(i);

query I
SELECT corr(yhat, f1 * 0.7 + 3) > 0.99 AND max(abs(yhat - (f1 * 0.7 + 3))) < 3
FROM tabfm_regress('reg_in', 'target', model := 'limix-2m') WHERE NOT is_training;
----
true

# ---------------------------------------------------------------------------
# Google TabFM 1.1.0 (`tabfm-v1-1`): the v1 architecture at embed_dim 128, BF16 weights.
#
# The checkpoint is what changed (embed_dim 256 -> 128, an explicit decoder_hidden, BF16 instead of
# F32), so these are the assertions that would notice a wrong wiring: a scrambled map or a BF16
# misread predicts at chance here and still "runs". Measured on this split (CPU): accuracy 0.969,
# R^2 0.99996 (tabfm-v1 on the same split: 0.969 and 0.99991, at ~7x the CPU time). The context-row
# oracles are the same ones every other model passes.
#
# Parity with upstream is exercised out-of-band, where the vendor PyTorch model is available
# (docs/REAL_MODELS.md, "Google TabFM 1.1"): the shipped graph with the real weights injected
# matches vendor/tabfm's TabFM forward to <= 7.6e-05 (classification logits) / 2.5e-06 (regression).

statement ok
CREATE TABLE c_v11 AS
SELECT row_id, yhat FROM tabfm_classify('ctx_cls', 'y', test := 'qry', model := 'tabfm-v1-1');

query I
SELECT count(*) FROM c_v11 WHERE yhat IS NULL
----
0

query I
SELECT (SELECT count(*) FILTER (WHERE c.yhat = t.y) FROM c_v11 c JOIN truth t USING (row_id)) * 1.0
       / (SELECT count(*) FROM truth) >= 0.90
----
true

statement ok
CREATE TABLE r_v11 AS
SELECT row_id, yhat FROM tabfm_regress('ctx_reg', 'tgt', test := 'qry', model := 'tabfm-v1-1');

query I
SELECT 1 - sum(power(r.yhat - t.tgt, 2)) / sum(power(t.tgt - (SELECT avg(tgt) FROM truth), 2)) >= 0.80
FROM r_v11 r JOIN truth t USING (row_id)
----
true

query I
SELECT sum(CASE WHEN yhat = label THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.9
FROM tabfm_classify('sep_t', 'label', model := 'tabfm-v1-1') WHERE is_training;
----
true

query I
SELECT sum(CASE WHEN yhat = 'c' || round(f1 / 10)::INTEGER THEN 1 ELSE 0 END)::DOUBLE / count(*) > 0.9
FROM tabfm_classify('sep_t', 'label', model := 'tabfm-v1-1') WHERE NOT is_training;
----
true

query I
SELECT corr(yhat, target) > 0.9
FROM tabfm_regress('reg_t', 'target', model := 'tabfm-v1-1') WHERE is_training;
----
true

# --- Mitra-v2 (AWS AutoGluon) and TabDPT v1.3 (Layer 6) -------------------------------------------
#
# Both are NEW entries beside the versions they supersede (`mitra`, `tabdpt` are unchanged), and both
# are Apache-2.0 and ungated. Weights:
#
#   CALL tabfm_download('classification', model := 'mitra-v2');
#   CALL tabfm_download('regression', model := 'mitra-v2');
#   CALL tabfm_download('classification', model := 'tabdpt-v1-3');   -- one file, both tasks
#
# mitra-v2 classification runs mitra's own graph on the v2 weights (byte-identical safetensors
# header); its regression is a new graph for the 1,000-bin head. tabdpt-v1-3 is a re-export for v1.3's
# per-task y-encoders. Same split and floors as every entry above.

statement ok
SET anofox_tabfm_device = 'cpu';

statement ok
CREATE TABLE c_m2 AS
SELECT row_id, yhat FROM tabfm_classify('ctx_cls', 'y', test := 'qry', model := 'mitra-v2');

query I
SELECT count(*) FROM c_m2 WHERE yhat IS NULL
----
0

query I
SELECT (SELECT count(*) FILTER (WHERE c.yhat = t.y) FROM c_m2 c JOIN truth t USING (row_id)) * 1.0
       / (SELECT count(*) FROM truth) >= 0.90
----
true

statement ok
CREATE TABLE r_m2 AS
SELECT row_id, yhat FROM tabfm_regress('ctx_reg', 'tgt', test := 'qry', model := 'mitra-v2');

query I
SELECT 1 - sum(power(r.yhat - t.tgt, 2)) / sum(power(t.tgt - (SELECT avg(tgt) FROM truth), 2)) >= 0.80
FROM r_m2 r JOIN truth t USING (row_id)
----
true

# mitra and mitra-v2 classification share a graph and a tensor map, so only DIFFERENT weights make
# their answers differ. A cache or URL mix-up would leave both serving the same bytes and every floor
# above would still pass; the class probabilities of two different checkpoints never coincide.
query I
SELECT max(abs(a.proba['a'] - b.proba['a'])) > 1e-4
FROM (SELECT row_id, proba FROM tabfm_classify('ctx_cls', 'y', test := 'qry', model := 'mitra')) a
JOIN (SELECT row_id, proba FROM tabfm_classify('ctx_cls', 'y', test := 'qry', model := 'mitra-v2')) b
  USING (row_id)
----
true

# The 1,000-bin decode on a noise-free linear target: no shrinkage toward the mean (slope of truth on
# prediction ~1), at the original scale AND at x1000 + 7000. The graph min-max scales the target over
# the context itself, so -- unlike v1's scalar head on a z-scored target -- the engine's target
# scaling cannot shrink it. Features are unique per row (hashes); predictions join back on them.
statement ok
CREATE TABLE m2_all AS
SELECT i, (hash(i * 3) % 1000) / 100.0 AS x1, (hash(i * 7) % 1000) / 100.0 AS x2, (hash(i * 11) % 1000) / 100.0 AS x3
FROM range(450) t(i);

statement ok
CREATE TABLE m2_ctx AS SELECT x1, x2, x3, 3 * x1 + 2 * x2 - x3 AS y FROM m2_all WHERE i < 300;

statement ok
CREATE TABLE m2_ctx_s AS SELECT x1, x2, x3, 1000 * (3 * x1 + 2 * x2 - x3) + 7000 AS y FROM m2_all WHERE i < 300;

statement ok
CREATE TABLE m2_qry AS SELECT x1, x2, x3 FROM m2_all WHERE i >= 300;

statement ok
CREATE TABLE m2_truth AS SELECT x1, x2, x3, 3 * x1 + 2 * x2 - x3 AS y FROM m2_all WHERE i >= 300;

query I
SELECT (1 - sum((t.y - p.yhat) ^ 2) / sum((t.y - (SELECT avg(y) FROM m2_truth)) ^ 2)) > 0.99
       AND abs(regr_slope(t.y, p.yhat) - 1.0) < 0.05
FROM tabfm_regress('m2_ctx', 'y', test := 'm2_qry', model := 'mitra-v2') p JOIN m2_truth t USING (x1, x2, x3)
----
true

query I
SELECT (1 - sum((1000 * t.y + 7000 - p.yhat) ^ 2) / sum((1000 * t.y + 7000 - (SELECT avg(1000 * y + 7000) FROM m2_truth)) ^ 2)) > 0.99
       AND abs(regr_slope(1000 * t.y + 7000, p.yhat) - 1.0) < 0.05
FROM tabfm_regress('m2_ctx_s', 'y', test := 'm2_qry', model := 'mitra-v2') p JOIN m2_truth t USING (x1, x2, x3)
----
true

# The wider size regime (256 features, v1: 100): 160 columns, four of them informative, the rest
# deterministic noise. v1's graph (which v2 classification reuses) was traced with H <= 100; the ONNX
# axis is symbolic, so this is what proves a 160-wide table really runs through it.
statement ok
