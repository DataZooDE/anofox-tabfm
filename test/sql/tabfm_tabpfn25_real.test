# name: test/sql/tabfm_tabpfn25_real.test
# description: RealTabPFN-2.5 (`tabpfn-v2-5-real`) — the real-data continued
#              pre-training of TabPFN-2.5, #4 on the TabArena v0.1.4 board.
#              It ships as a SEPARATE catalog entry rather than a checkpoint
#              flag because the two score differently and users pick between
#              them by name.
#
#              The whole reason this entry is cheap is that it is the SAME
#              architecture as `tabpfn-v2-5`: identical tensor names, shapes and
#              dtypes, so it reuses the bundled graph, the bundled tensor map and
#              the bundled ext-graph header sha VERBATIM. Nothing new is embedded
#              in the binary. Those shared-resource claims are asserted below —
#              they must fail loudly if a future checkpoint diverges.
#
#              It does NOT share the cache path: both checkpoints live in the
#              same HF repo (Prior-Labs/tabpfn_2_5), and the cache slug is keyed
#              by repo, so a shared files[].path would make the two entries
#              overwrite each other's weights. Hence `classification-real/`.
# group: [anofox_tabfm]

require anofox_tabfm

require notwindows

statement ok
LOAD anofox_tabfm

# --- the built-in catalog entry ------------------------------------------------

query TTT
SELECT model, family, capabilities FROM tabfm_list_models() WHERE model = 'tabpfn-v2-5-real'
----
tabpfn-v2-5-real	icl-transformer	classify, regress

# same licence posture as the 2.5 line it continues: non-commercial + gated
query TTT
SELECT model, license, commercial FROM tabfm_list_models()
WHERE model IN ('tabpfn-v2-5', 'tabpfn-v2-5-real') ORDER BY model
----
tabpfn-v2-5	tabpfn-2.5-license-v1.1	false
tabpfn-v2-5-real	tabpfn-2.5-license-v1.1	false

# --- the fixture model (real forward pass through the SHARED 2.5 graph) --------

# There is deliberately no test/fixtures/tabpfn25_real: sharing the tabpfn25
# fixture is the point. If the real checkpoint ever stops loading into the 2.5
# graph, this registration is what breaks.
statement ok
CALL tabfm_register_model(
  id := 'tabpfn-v2-5-real-fixture', base_dir := 'test/fixtures/tabpfn25',
  classification_graph := 'graph_tabpfn25_classification.onnx',
  regression_graph := 'graph_tabpfn25_regression.onnx',
  classification_weights := 'model.safetensors',
  regression_weights := 'model_regression.safetensors',
  classification_tensor_map := 'tensor_map_tabpfn25_classification.json',
  regression_tensor_map := 'tensor_map_tabpfn25_regression.json',
  license := 'tabpfn-2.5-license-v1.1', commercial := false,
  preprocessing_profile := 'tabpfn_v2_5_raw',
  max_rows := 4096, max_features := 64, max_classes := 4)

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,'c0'),(1.5,0.2,0.3,'c1'),(2.5,-1.0,0.5,'c2'),
  (0.2,0.8,0.7,'c0'),(1.1,0.4,0.2,'c1'),(3.0,-0.5,0.9,'c2'),
  (0.9,1.2,0.6,'c0'),(2.1,0.1,0.4,'c1'),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,label);

query II
SELECT count(*), count(*) FILTER (WHERE yhat NOT IN ('c0','c1','c2'))
FROM tabfm_classify('t', 'label', model := 'tabpfn-v2-5-real-fixture')
----
10	0

statement ok
CREATE TABLE r AS SELECT * FROM (VALUES
  (0.5,1.0,0.1,1.2),(1.5,0.2,0.3,2.4),(2.5,-1.0,0.5,3.1),
  (0.2,0.8,0.7,0.9),(1.1,0.4,0.2,1.8),(3.0,-0.5,0.9,3.6),
  (0.9,1.2,0.6,1.1),(2.1,0.1,0.4,2.7),
  (1.3,0.3,0.35,NULL),(2.4,-0.2,0.55,NULL))
  v(f1,f2,f3,target);

query II
SELECT count(*), count(*) FILTER (WHERE yhat IS NULL)
FROM tabfm_regress('r', 'target', model := 'tabpfn-v2-5-real-fixture')
----
10	0
